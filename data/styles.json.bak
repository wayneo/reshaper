[
  {
    "id": "ink-sticker",
    "title": "Ink Sticker",
    "prompt": "Completely preserve the original real-world scene, lighting, composition, background, and environmental textures without stylizing or replacing them. Transform only the main subject (the person or people) in the image into a clean, minimal black-and-white Japanese-illustration-style ink line character sticker. Render the figure using simple, confident black linework of even, moderate weight, avoiding dense cross-hatching, excessive interior linework, or heavy shading. Do not add any color: the figure must be strictly black ink line on white, with no color fill, no tonal color blocks, and no gradients, using only sparse solid-black shadow shapes where needed for depth. Keep facial features minimal and clean, simple line eyes, nose, and mouth rather than detailed rendering. The result should feel like an uncluttered, airy Japanese ink-line character sticker, simplified and flat rather than densely illustrated or colored. Finish with a clean white sticker trim. Preserve recognizable identity, pose, clothing silhouette, placement, facial expression, and the source image aspect ratio. Keep the image exceptionally crisp.",
    "identityMode": "reinforced",
    "imageFile": "673dc3a2-55c3-47cf-87b5-8faf529fe4eb.jpg",
    "enabled": true,
    "order": 34,
    "createdAt": "2026-07-20T00:00:00.000Z",
    "updatedAt": "2026-07-31T03:10:28.363Z",
    "categoryId": "4ed760a1-09f7-4274-aa0d-83a30ca389db",
    "titleZh": "墨線貼紙",
    "promptZh": "完全保留原始真實場景、光線、構圖、背景與環境質感，不進行風格化或替換。僅將圖像中的人物轉變為乾淨、簡約的黑白日式插畫風格墨線貼紙人物。"
  },
  {
    "id": "food-in-motion",
    "title": "Food in Motion",
    "prompt": "Keep the subject’s face, identity, expression, realistic skin texture, pose, lighting, surrounding real-life scene, and source image aspect ratio unchanged. Transform the food held by the subject into a dramatic yet photorealistic suspended slow-motion moment: ingredients and small pieces of food float naturally just above and around the hand, with tiny oil droplets and delicate food splashes frozen sharply in the air. Preserve correct anatomy and keep the effect focused only around the food and hand. Use high-definition live-action DSLR food photography, crisp yet soft natural detail, realistic droplets, subtle ingredient motion, shallow cinematic depth of field, and a lively premium food-travel atmosphere. Do not add text, logos, or extra people.",
    "identityMode": "reinforced",
    "imageFile": "01c5afa9-cbdd-45ed-80fb-83f79846b7be.jpg",
    "enabled": true,
    "order": 35,
    "createdAt": "2026-07-20T00:00:00.000Z",
    "updatedAt": "2026-07-31T03:21:28.019Z",
    "categoryId": "aab9b995-1170-4176-a8c5-2d6748caf430",
    "titleZh": "食物動態",
    "promptZh": "保持主體的臉部、身份、表情、真實膚質、姿勢、光線、周圍真實場景與原圖比例不變。將主體手中的食物轉變為戲劇化卻寫實的懸浮慢動作瞬間：食材與細小食物碎片自然地漂浮在手部上方與周圍，細小的油滴與精緻的食物飛濺瞬間凝結於空中。保持正確的人體結構，並讓效果僅聚焦於食物與手部周圍。使用高畫質實拍單眼美食攝影風格，清晰又柔和的自然細節、真實的水珠、細微的食材動態、淺景深的電影感，以及生動高級的美食旅遊氛圍。不要添加文字、標誌或多餘人物。"
  },
  {
    "id": "3d-character",
    "title": "3D Character",
    "prompt": "Transform the subject into a full-body 3D-inspired illustrated character: stylized proportions, smooth sculpted forms, soft subsurface shading, clean rounded shapes, and the polished render quality of premium 3D character art. Preserve recognizable identity, facial likeness, hairstyle, and clothing style, translated into the same charming 3D illustration style. Keep the subject’s apparent gender, age, and body proportions consistent with the source photo — stylize the rendering, not the person’s underlying build. If the source photo doesn’t show the full body, sensibly extend the visible clothing downward in a matching color and pattern rather than inventing a different outfit. Show the character standing full-body, centered, in a clean photography-studio setting against a warm solid terracotta backdrop with soft studio lighting, gentle contact shadow beneath the feet, and subtle rim light. Do not add text, logos, props, or extra characters.",
    "identityMode": "reinforced",
    "imageFile": "082bb4da-be46-4662-885b-24c51894b26a.jpg",
    "enabled": true,
    "order": 36,
    "createdAt": "2026-07-20T00:00:00.000Z",
    "updatedAt": "2026-07-31T03:21:28.028Z",
    "categoryId": "38d3befa-39e5-47d4-bf0b-a140792b2ac3",
    "titleZh": "3D 角色",
    "promptZh": "將主體轉變為全身3D風插畫角色：風格化比例、平滑雕塑感造型、柔和的次表面散射陰影、簡潔圓潤的形狀，以及高級3D角色藝術般精緻的渲染品質。保留可辨識的身份、面部特徵、髮型與服裝風格，並轉譯為同樣迷人的3D插畫風格。保持主體外顯的性別、年齡與體型比例與原照片一致——僅將呈現方式風格化，而非改變其真實體型。若原照片未顯示全身，請以相符的顏色與圖案合理向下延伸可見的服裝，而非虛構不同的服裝。讓角色以全身站姿、居中呈現，置於乾淨的攝影棚場景中，背景為暖色調的純赤陶色，搭配柔和棚燈、腳下柔和的接觸陰影，以及細膩的輪廓光。不要添加文字、標誌、道具或多餘角色。"
  },
  {
    "id": "collage-portrait",
    "title": "Collage Portrait",
    "prompt": "Using the uploaded photo as the sole identity reference, strictly preserve the subject’s real face shape, facial feature proportions, eyebrow and eye characteristics, nose and lip contour, skin tone, hairstyle, and personal likeness. Compose a vertical vintage collage-art portrait: a close-up half-body or head-and-shoulders view, body turned slightly to the side, face toward the camera, with a calm, detached, faintly scrutinizing expression. Render the face with a black-and-white old-newspaper print look, pen stippling, and fine halftone dot texture; render the hair as large blocks of deep black with a few loose stray strands. Split the head, neck, and clothing into irregular paper slices, as if hand-torn and reassembled, with some edges overlapping, offset, or cut — but keep every facial feature naturally and accurately positioned. Lay a saturated rose-magenta, semi-transparent paper strip horizontally across the eyes, keeping both eyes still clearly visible beneath it. Add a sky-blue peeling old-wall texture, black-and-white diagonal stripes, deep-blue grid lines, and a yellow-green maze/zigzag pattern along the side of the face and neck. Build the shoulders and clothing from geometric-patterned paper pieces in orange-red, coral pink, lake blue, and magenta-purple. Set the background as warm, aged cream paper with subtle fiber texture, fading, ink wear, print misregistration, and photocopy grain. Blend mid-20th-century paper collage, vintage magazine portraiture, screen printing, brutalist composition, and contemporary editorial illustration into one bold but controlled palette with generous negative space, like a collectible limited-edition art print. Do not add a photorealistic 3D background, smooth digital gradients, a swapped or distorted face, misplaced facial features, extra people, garbled text, a cheap sticker look, an overly tidy composition, or plastic-looking skin.",
    "identityMode": "reinforced",
    "imageFile": "ef9e3d7f-e8d5-4d9e-b4b9-f8e0e392fcb4.jpg",
    "enabled": true,
    "order": 37,
    "createdAt": "2026-07-20T00:00:00.000Z",
    "updatedAt": "2026-07-31T03:21:28.032Z",
    "categoryId": "6ad0a676-4347-4eb6-9db1-7b3938f373ae",
    "titleZh": "拼貼肖像",
    "promptZh": "僅以上傳照片作為唯一身份參考，嚴格保留主體真實的臉型、五官比例、眉眼特徵、鼻唇輪廓、膚色、髮型與個人特徵。構圖為直式復古拼貼藝術肖像：近距離半身或頭肩景，身體微側，臉朝鏡頭，帶著平靜、疏離、略帶審視的表情。以黑白老報紙印刷質感呈現臉部，搭配鋼筆點畫與細緻網點紋理；頭髮則呈現為大塊深黑色，帶幾縷散落髮絲。將頭部、頸部與服裝切割成不規則的紙片，彷彿手撕後重新拼貼而成，部分邊緣重疊、錯位或裁切——但每個五官仍須自然且準確地定位。在雙眼處橫向鋪上一條飽和玫瑰洋紅色的半透明紙條，讓雙眼在其下仍清晰可見。在臉部與頸部側邊加入天藍色的斑駁舊牆質感、黑白斜紋條紋、深藍色格線，以及黃綠色的迷宮／鋸齒圖案。以橘紅、珊瑚粉、湖藍與洋紅紫色的幾何圖案紙片構成肩膀與服裝。背景設定為溫暖做舊的米色紙張，帶有細膩纖維質感、褪色感、油墨磨損、印刷套色不準與影印顆粒感。融合二十世紀中葉紙藝拼貼、復古雜誌肖像、絹印、粗獷主義構圖與當代編輯插畫，呈現大膽卻節制的色調，並保留大量留白，宛如限量收藏版藝術版畫。不要生成寫實3D背景、平滑數位漸層、被替換或扭曲的臉部、錯位的五官、多餘人物、亂碼文字、廉價貼紙感、過於工整的構圖，或塑膠感的皮膚。"
  },
  {
    "id": "photo-booth-grid",
    "title": "Photo Booth Grid",
    "prompt": "Using the uploaded photo as the sole reference for identity and appearance, generate a vertical, 4×4 sixteen-panel black-and-white photo-booth expression portrait grid. Strictly preserve the subject’s real, recognizable face shape, feature proportions, skin tone, apparent age, hairstyle, and hairline — do not swap identity, do not idealize into a celebrity look, and do not change gender or bone structure. Show the same person in all sixteen cells, wearing a simple plain black crew-neck T-shirt, facing the camera in a close head-and-shoulders crop, with camera angle, focal length, framing, background, clothing, and lighting completely uniform across every cell. Use a light gray seamless studio background, with neat thin black divider lines separating the cells, evoking a vintage ID-photo or photo-booth strip. Give each cell a different expression or gesture, in this order: eyes closed with cheeks squeezed into a smile; both hands forming a V-shape framing the eyes; mouth wide open laughing; both hands cupping the chin, daydreaming; a sulky pout; both hands making “horns” above the head; a playful tongue-out face; head lowered in a serious stare; one hand resting on the cheek with a faint smile; eyes wide open in surprise; both hands beside the mouth as if shouting; both hands shaped like little monster claws; a puzzled frown; both hands clutching the head in mock despair; eyes closed with tongue out in a silly face; and a naturally relaxed smile. Render it as classic black-and-white portrait photography: high-contrast grayscale, soft frontal studio lighting, fine skin texture, and subtle film grain with a vintage print quality. Keep identity highly consistent across every cell, hands and fingers naturally formed, and expressions lively without becoming distorted. Fill the frame completely. Do not add text, logos, watermarks, or a small colored reference avatar in the corner.",
    "identityMode": "reinforced",
    "imageFile": "80de85fe-f371-4fab-8104-a69f9c30d881.jpg",
    "enabled": true,
    "order": 38,
    "createdAt": "2026-07-20T00:00:00.000Z",
    "updatedAt": "2026-07-31T03:21:28.036Z",
    "categoryId": "aab9b995-1170-4176-a8c5-2d6748caf430",
    "titleZh": "大頭貼方格",
    "promptZh": "僅以上傳照片作為身份與外貌的參考依據，生成一張直式、4×4共十六格的黑白大頭貼表情方格肖像。嚴格保留主體真實可辨識的臉型、五官比例、膚色、外顯年齡、髮型與髮際線——不得替換身份、不得將其美化成明星臉，也不得改變性別或骨骼結構。十六格中皆為同一人，穿著簡單的素色黑色圓領T恤，面對鏡頭以近距離頭肩景呈現，每格的鏡頭角度、焦段、構圖、背景、服裝與光線完全一致。使用淺灰色無縫棚拍背景，並以細緻的黑色分隔線區隔每一格，呈現如復古證件照或大頭貼機的效果。讓每一格呈現不同的表情或動作，依序為：閉眼微笑並用力擠出臉頰；雙手比出V字形框住雙眼；張大嘴巴大笑；雙手托著下巴發呆；噘嘴不悅；雙手在頭上比出「角」的形狀；俏皮吐舌；低頭嚴肅凝視；一手托腮並帶著淺笑；雙眼睜大露出驚訝表情；雙手放在嘴邊彷彿在呼喊；雙手做成小怪獸爪子的形狀；困惑皺眉；雙手抱頭做出誇張苦惱狀；閉眼吐舌做鬼臉；以及自然放鬆的微笑。以經典黑白肖像攝影風格呈現：高對比灰階、柔和正面棚燈、細緻的皮膚質感，以及帶有復古印刷質感的細微膠片顆粒。保持每一格的身份高度一致、雙手與手指自然成形，表情生動但不失真。畫面須完整填滿。不要添加文字、標誌、浮水印，或角落的小型彩色參考頭像。"
  },
  {
    "id": "paper-mascot",
    "title": "Paper Mascot",
    "prompt": "Convert this photo into a soft, handcrafted paper-cut layered illustration in the style of a cute mascot character, inspired by papercraft diorama aesthetics. Reinterpret the subject’s pose, outfit, and general silhouette using smooth rounded shapes, simplified cute proportions, and minimal facial details (simple dot eyes, blush cheeks) for a warm, charming look — the character is a cute stylized mascot and does not need to closely resemble the real person’s face. Apply stacked paper layers with visible depth, subtle shadows between layers, and clean cut edges that resemble laser-cut cardstock. Add a distinct white outer outline layer surrounding the character, resembling a thick sticker border or white cut-paper backing, clearly separating it from the background — this white layer should feel like an intentional paper layer, not a glow. Use a pastel color palette with muted blues, greens, and warm neutrals, balanced and calming. Light it softly and evenly, enhancing the dimensional paper layers without harsh contrast. Textures should appear matte and tactile, like thick art paper or craft foam. Overall mood: cozy, wholesome, gentle, and storybook-like, with a playful yet polished handcrafted feel suitable for modern illustration, children’s books, or decorative art. Do not add text, logos, watermarks, or extra characters.",
    "identityMode": "none",
    "imageFile": "c78487e9-7719-4c13-98a1-d06b486aa074.jpg",
    "enabled": true,
    "order": 39,
    "createdAt": "2026-07-20T00:00:00.000Z",
    "updatedAt": "2026-07-31T03:21:28.040Z",
    "categoryId": "6ad0a676-4347-4eb6-9db1-7b3938f373ae",
    "titleZh": "紙藝吉祥物",
    "promptZh": "將這張照片轉換為柔和、手工感的紙雕分層插畫，呈現可愛吉祥物角色的風格，靈感來自紙藝立體模型美學。以平滑圓潤的造型、簡化的可愛比例，以及極簡的五官（簡單的點狀眼睛、腮紅雙頰）重新詮釋主體的姿勢、服裝與整體輪廓，營造溫暖迷人的觀感——這個角色是可愛的風格化吉祥物，不需要與真人臉部高度相似。運用堆疊的紙層呈現可見的深度、層與層之間的細緻陰影，以及如雷射切割卡紙般乾淨的裁切邊緣。在角色外圍加上明顯的白色外框層，宛如厚實的貼紙邊框或白色裁紙底層，使其與背景清楚區隔——這層白色應讓人感覺是刻意的紙層，而非光暈效果。使用粉彩色調，搭配柔和的藍色、綠色與暖色中性色，平衡且療癒。以柔和均勻的光線照亮，凸顯立體紙層而不產生強烈對比。質感應呈現霧面且具觸感，如厚磅美術紙或工藝泡棉。整體氛圍：溫馨、療癒、柔和且如繪本般，帶著俏皮又精緻的手工感，適合現代插畫、童書或裝飾藝術。不要添加文字、標誌、浮水印或多餘角色。"
  },
  {
    "id": "doodle-journal",
    "title": "Doodle Journal",
    "prompt": "Using the uploaded photo as the sole visual reference, completely preserve the identity, action or pose, clothing, expression, scene, lighting, camera angle, and subject placement of the people or objects in the original image — do not alter the person’s likeness, do not swap the background, and do not generate unrelated elements. Create a vertical, fresh and natural lifestyle-photography poster by adding white and pale cream hand-drawn doodles and casual handwritten short phrases onto the surface of the original photo. Distribute the doodles naturally around the subject without covering the face, hands, or core objects, including fine-line figure outlines, curved arrows, hearts, sparkles, musical notes, a sun, clouds, wind lines, birds, flowers, dashed paths, small flashes of light, and wavy underlines. Automatically generate 5 to 8 short English mood phrases based on the content of the original image (for example “QUIET TIME,” “GOOD VIBES,” “JUST BREATHE,” “LITTLE JOYS,” “BEST DAY EVER,” “FREE AS THE SKY”) — the text must relate to the scene, use a natural, irregular handwritten font with varied sizes, and be arranged along the subject’s action or the visual flow of the image, avoiding mechanical symmetry or dense clustering. The overall feel should combine a travel journal, a personal diary, and independent-magazine photography. Preserve authentic photographic texture, natural skin tone, environmental depth of field, and the original color grading — only moderately enhance sunlight, atmosphere, and warmth. The doodles should look hand-drawn afterward with crayon, chalk, and a fine-tip marker, with slightly shaky, genuine linework that blends with the photo while staying legible. Do not cartoonize the subject, change the subject, distort fingers, add garbled text, modern UI elements, complex infographics, brand watermarks, social-media handles, borders or collage frames, or extra thumbnail images.",
    "identityMode": "reinforced",
    "imageFile": "393473fa-5baa-4186-ab7b-352bb321c95f.jpg",
    "enabled": true,
    "order": 40,
    "createdAt": "2026-07-20T00:00:00.000Z",
    "updatedAt": "2026-07-31T03:21:28.045Z",
    "categoryId": "4ed760a1-09f7-4274-aa0d-83a30ca389db",
    "titleZh": "塗鴉手帳",
    "promptZh": "僅以上傳照片作為唯一視覺參考，完全保留原圖中人物或物件的身份、動作或姿勢、服裝、表情、場景、光線、鏡頭角度與主體位置——不得改變人物的樣貌、不得替換背景，也不得生成無關元素。透過在原照片表面加上白色與淡奶油色的手繪塗鴉與隨性手寫短句，創造一張直式、清新自然的生活風格攝影海報。將塗鴉自然地分布於主體周圍，避免遮蓋臉部、雙手或核心物件，內容包括細線人物輪廓、彎曲箭頭、愛心、閃光、音符、太陽、雲朵、風的線條、鳥兒、花朵、虛線路徑、小光點與波浪底線。根據原圖內容自動生成5到8句簡短的英文情緒短句（例如「QUIET TIME」「GOOD VIBES」「JUST BREATHE」「LITTLE JOYS」「BEST DAY EVER」「FREE AS THE SKY」）——文字須與場景相關，使用自然不規則、大小不一的手寫字體，並沿著主體動作或畫面視覺動線排列，避免機械式對稱或密集堆疊。整體氛圍應融合旅行手帳、個人日記與獨立雜誌攝影的感覺。保留真實的攝影質感、自然膚色、環境景深與原始調色——僅適度增強陽光感、氛圍與暖度。塗鴉應呈現事後以蠟筆、粉筆與細字馬克筆手繪的效果，線條略帶顫抖卻真實，與照片融合又保持清晰可辨。不要將主體卡通化、改變主體、扭曲手指、加入亂碼文字、現代UI元素、複雜資訊圖表、品牌浮水印、社群帳號標籤、邊框或拼貼相框，或多餘的縮圖。"
  },
  {
    "id": "studio-campaign",
    "title": "Studio Campaign",
    "prompt": "Generate a fashion portrait using the uploaded photo as the sole identity reference for the person, retaining their real, natural, and recognizable appearance while placing them into a playful, warm studio photography scene. The result should feel like a portrait from a young lifestyle brand, a trendy apparel campaign, or an independent creative magazine — not an ordinary ID photo, an influencer selfie, a flat illustration, or an obviously AI-synthesized portrait. Strictly reference the person’s appearance from the uploaded photo, preserving: the same facial identity and overall bone structure; the same face shape, eyebrow and eye proportions, nose shape, and lip contour; the same skin tone and apparent age; the same hair color, hairline, and primary hairstyle features; and the same natural temperament and personal recognizability. Do not replace the person with a random model, do not noticeably change their face shape, and do not over-infantilize, over-influencer-ify, or Westernize their look. Keep the subject’s apparent gender, age, and body proportions consistent with the source photo. Dress the subject in a thick cotton hoodie, cream-colored trousers, and white sneakers. If the source photo doesn’t show the full body, sensibly complete the rest of the pose and outfit in a natural, consistent way rather than inventing something unrelated. Set the scene in a clean, seamless light-gray photography studio, with the floor and background blending naturally — no furniture, complex props, windows, text, or environmental clutter. Use a vertical, full-body seated portrait composition. Position the subject center-low in the frame, casually seated on the studio floor with legs naturally crossed, body relaxed and leaning slightly forward, for an intimate, soft, unforced pose. Fully show the head, upper body, crossed legs, and shoes; let the subject occupy the main area of the frame with adequate negative space above the head and around the body. Have a small, cute, cartoon-style doodle version of the same subject — a simplified, chibi-like illustrated caricature of them, not a random or unrelated character — peek out from behind the subject, interacting closely with them; the subject’s face and the doodle character’s head together form the visual center of the image. Do not crop the shoes, pant legs, or arms awkwardly. Keep the overall composition simple, focused, and stable — avoid an overly full frame or a subject that appears too small. Light the scene with soft, diffused studio light. Let the main light fall naturally from the front-upper side of the subject, using a large soft-light source so the light evenly covers the face, clothing, and trousers. The lighting should render soft, natural facial shading; clear but not overly sharp facial features; the thick cotton texture of the hoodie; the natural creases of the cream-colored trousers; the structural detail of the white sneakers; and a subtle, soft contact shadow between the subject and the ground. Keep the background bright and clean, but not blown-out pure white. Avoid harsh shadows, oily highlights, or strong rim lighting on the face. Simulate a 50mm portrait lens with a medium depth of field, slight background softening, and natural, accurate body proportions.",
    "identityMode": "reinforced",
    "imageFile": "c0f8198d-8791-46fd-b035-b376b77eda9f.jpg",
    "enabled": true,
    "order": 41,
    "createdAt": "2026-07-20T00:00:00.000Z",
    "updatedAt": "2026-07-31T03:21:28.049Z",
    "categoryId": "aab9b995-1170-4176-a8c5-2d6748caf430",
    "titleZh": "型錄棚拍",
    "promptZh": "僅以上傳照片作為人物身份的唯一參考，生成一張時尚肖像，保留其真實、自然且可辨識的外貌，並將其置入一個俏皮溫暖的棚拍場景中。成品應呈現如年輕生活品牌、潮流服飾廣告或獨立文藝雜誌般的肖像感——而非普通證件照、網紅自拍、平面插畫，或明顯的AI合成肖像。嚴格參考上傳照片中人物的外貌，保留：相同的臉部身份與整體骨架；相同的臉型、眉眼比例、鼻型與唇形；相同的膚色與外顯年齡；相同的髮色、髮際線與主要髮型特徵；以及相同的自然氣質與個人辨識度。不得以隨機模特取代該人物，不得明顯改變其臉型，也不得過度幼態化、過度網紅化或西化其外貌。保持主體外顯的性別、年齡與體型比例與原照片一致。讓主體穿著厚棉帽T、米色長褲與白色運動鞋。若原照片未顯示全身，請以自然一致的方式合理補全其餘姿勢與服裝，而非虛構無關內容。場景設定在乾淨無縫的淺灰色攝影棚，地板與背景自然融合——不設置家具、複雜道具、窗戶、文字或環境雜物。採用直式全身坐姿構圖。將主體置於畫面中下方，隨性地坐在攝影棚地板上，雙腿自然交叉，身體放鬆並微微前傾，呈現親密、柔和、不刻意的姿態。完整呈現頭部、上半身、交叉的雙腿與鞋子；讓主體佔據畫面主要區域，並在頭部上方與身體周圍留有充足的留白。讓一個小巧可愛、卡通風格的塗鴉版本主體——一個簡化的Q版插畫分身，而非隨機或無關的角色——從主體身後探出頭來，與其親密互動；主體的臉部與塗鴉角色的頭部共同構成畫面的視覺中心。不要不當裁切鞋子、褲管或手臂。保持整體構圖簡潔、聚焦且穩定——避免畫面過滿或主體顯得過小。以柔和漫射的棚燈照亮場景。讓主光自然地從主體前上方灑落，使用大面積柔光源，使光線均勻覆蓋臉部、服裝與長褲。燈光應呈現柔和自然的臉部陰影；清晰但不過度銳利的五官；帽T厚實的棉質質感；米色長褲自然的皺褶；白色運動鞋的結構細節；以及主體與地面之間柔和細膩的接觸陰影。保持背景明亮乾淨，但不過曝成純白。避免生硬陰影、油光高光，或臉部強烈的輪廓光。模擬50mm人像鏡頭、中等景深、背景微微柔化，以及自然準確的人體比例。"
  },
  {
    "id": "0832ac8e-34f7-4655-ade2-5ab26df90be4",
    "title": "Funny Doodle",
    "prompt": "Transform the original image into a clumsy, funny, absurd doodle illustration. Use an affordable marker-and-crayon hand-drawn sketch texture; messy, shaky lines with the feel of a child’s random drawing. Use distorted perspective, unbalanced object proportions, and exaggerated, deformed facial features for maximum comic effect.\n\nAdd a simple comic-style background that suits the original scene, filled with chaotic scribbles and small casual decorative details. Use uneven colouring, with paint often going outside the outlines; make the strokes rough and obvious. The overall look should feel deliberately careless and sketchy—not polished or perfect—like a fun meme illustration with a relaxed internet vibe. Strictly avoid realism, refined detail, or neat professional illustration effects.",
    "identityMode": "reinforced",
    "imageFile": "44f8037f-1d28-470f-8485-233dad561135.jpg",
    "enabled": true,
    "order": 33,
    "createdAt": "2026-07-21T09:25:00.592Z",
    "updatedAt": "2026-07-31T03:21:28.053Z",
    "categoryId": "4ed760a1-09f7-4274-aa0d-83a30ca389db",
    "titleZh": "爆笑塗鴉",
    "promptZh": "將原圖轉變為笨拙、爆笑、荒謬的塗鴉插畫。使用平價馬克筆與蠟筆的手繪素描質感；線條凌亂顫抖，帶有孩童隨手塗鴉的感覺。運用扭曲的透視、失衡的物體比例，以及誇張變形的五官，營造最大的喜劇效果。加入符合原場景的簡易漫畫風背景，畫面充滿雜亂的塗鴉筆觸與隨性的小裝飾。上色不均勻，顏料經常溢出輪廓線；筆觸應粗糙且明顯。整體觀感應刻意呈現隨性潦草——而非精緻完美——如同帶有輕鬆網路氛圍的迷因插畫。嚴格避免寫實感、精緻細節或工整專業的插畫效果。"
  },
  {
    "id": "21a99243-eb3a-4b1d-8e9a-c6f062f55d23",
    "title": "Naïve Flat",
    "prompt": "Korean-style naïve flat illustration. Completely retain all objects and the original scene composition; use rough, jittery, broken black hand-drawn outlines. Thoroughly remove photographic lighting, spatial perspective, and realistic textures. Use solid blocks of colour, pairing high-saturation red, yellow, green, and white. Make all object edges rounded and simplify forms into basic geometric shapes. Create an overall soft, cute, childlike atmosphere, with a few casually hand-written cute captions in the image.",
    "identityMode": "reinforced",
    "imageFile": "dd978f7c-eb88-4aea-93dc-36355dd1bab9.jpg",
    "enabled": true,
    "order": 32,
    "createdAt": "2026-07-21T09:26:01.752Z",
    "updatedAt": "2026-07-31T03:21:28.057Z",
    "categoryId": "4ed760a1-09f7-4274-aa0d-83a30ca389db",
    "titleZh": "拙趣平塗",
    "promptZh": "韓系拙趣平塗插畫。完全保留所有物件與原場景構圖；使用粗糙顫抖、斷續的黑色手繪輪廓線。徹底去除攝影感的光影、空間透視與寫實質感。使用高飽和的紅、黃、綠、白實色色塊。讓所有物件邊緣圓潤化，並將造型簡化為基本幾何形狀。營造整體柔和可愛、童趣的氛圍，並在畫面中加入幾句隨性手寫的可愛短句。"
  },
  {
    "id": "612c3048-6f16-41ff-a6e9-940280ef30c1",
    "title": "Abstract Doodle",
    "prompt": "Soothing, childlike abstract flat illustration with free-flowing, stream-of-consciousness doodles. Use large areas of solid colour and cover the image with a rough, grainy texture. Colours should be bright and highly saturated; shapes should feel relaxed and spontaneous, with no strict realistic structure. Create a freely imagined, childlike doodle atmosphere.",
    "identityMode": "reinforced",
    "imageFile": "91c91c23-d680-4b38-9145-2ad5fa1d51cc.jpg",
    "enabled": true,
    "order": 31,
    "createdAt": "2026-07-21T09:28:14.537Z",
    "updatedAt": "2026-07-31T03:21:28.062Z",
    "categoryId": "4ed760a1-09f7-4274-aa0d-83a30ca389db",
    "titleZh": "抽象塗鴉",
    "promptZh": "療癒系童趣抽象平塗插畫，帶有自由流動、意識流般的塗鴉筆觸。使用大面積實色色塊，並在畫面覆蓋粗糙顆粒質感。色彩應明亮高飽和；造型應呈現放鬆隨性，不拘泥於寫實結構。營造自由想像、童趣塗鴉般的氛圍。"
  },
  {
    "id": "501fbcb7-1111-4534-b091-573e978a6aab",
    "title": "Hand-drawn Illustration",
    "prompt": "Japanese-style hand-drawn illustration with clearly defined people, objects, and scenery, rendered in high detail and quality. Use a manga-sketch foundation with casual, messy hand-drawn lines and light ink-wash brushwork. Keep the background clean, simple, and white, with scattered minimal symbolic decorative elements around the composition. Create a strong, striking overall mood with a prominent hand-drawn doodle texture.",
    "identityMode": "reinforced",
    "imageFile": "cc07a712-adcc-4978-88c3-74d8834d2041.jpg",
    "enabled": true,
    "order": 30,
    "createdAt": "2026-07-21T09:29:48.256Z",
    "updatedAt": "2026-07-31T03:23:23.333Z",
    "categoryId": "4ed760a1-09f7-4274-aa0d-83a30ca389db",
    "titleZh": "手繪插畫",
    "promptZh": "日式手繪插畫，人物、物件與場景輪廓清晰，呈現高細節與高品質。以漫畫素描為基礎，搭配隨性凌亂的手繪線條與淡雅的水墨渲染筆觸。保持背景乾淨簡約的白色，並在構圖周圍點綴極簡的象徵性裝飾元素。營造強烈鮮明的整體氛圍，並帶有明顯的手繪塗鴉質感。"
  },
  {
    "id": "e8aab9af-e552-4647-9c61-329d19321978",
    "title": "Retro Pop",
    "prompt": "Vector flat illustration in retro pop-art style, inspired by 1950s–60s vintage comic-book printing. Use halftone-dot textures and a rough screen-print feel; thick, crisp black outlines; simple flattened shapes; and a cute, playful cartoon style.\n\nNo realistic 3D shading—use dense and sparse halftone dots to define light and dark areas. Use a limited, high-saturation colour palette; no gradients or intricate details. Keep it strictly 2D flat, with no text in the image.\n\nUse a pure-white, delicate paper-like background with natural grain, slightly imperfect hand-drawn strokes, and a handmade vintage-print character. Keep the composition clean, with no unnecessary clutter.",
    "identityMode": "reinforced",
    "imageFile": "733ea917-42e9-406c-993f-ff0a9763a13e.jpg",
    "enabled": true,
    "order": 29,
    "createdAt": "2026-07-21T13:32:35.128Z",
    "updatedAt": "2026-07-31T03:23:23.344Z",
    "categoryId": "89d3d50f-6ef4-437c-95c0-c799f8fb6440",
    "titleZh": "復古普普風",
    "promptZh": "向量平塗插畫，呈現復古普普藝術風格，靈感來自1950至60年代的老式漫畫印刷。運用網點紋理與粗糙絹印質感；粗黑俐落的輪廓線；簡化的平面造型；以及可愛俏皮的卡通風格。不使用寫實3D陰影——以疏密不同的網點來表現明暗。使用有限的高飽和色盤；不使用漸層或繁複細節。保持嚴格的2D平面感，畫面中不含文字。使用純白、細緻如紙張般的背景，帶有自然顆粒感、略帶不完美的手繪筆觸，以及手工復古印刷般的質感。保持構圖乾淨，不含多餘雜物。"
  },
  {
    "id": "c33e8052-072f-4b95-a689-62c08eb784bf",
    "title": "Real Person + Cartoon Companion",
    "prompt": "Fully preserve the original person — position unchanged, face, hairstyle, body proportions, clothing, pose, stance, and photo texture all unchanged; do not redraw or move the person. Keep the background, street greenery, lighting, and composition exactly as in the original, only adding new content into empty areas of the frame. Add a cartoon character into the empty area, with outfit/styling and pose direction matching the original person; the cartoon character's height should take up a large portion of the frame, standing on the left side, noticeably taller than the original person. Use a cute, flat, hand-drawn sticker-illustration style — thick black outlines with a soft light-yellow edge stroke, macaron flat coloring, round cute expressions with pink blush, in a travel-journal sticker style. Add playful hand-drawn doodle decorations around the person: small colorful flowers, hollow flower outlines, wavy lines, short arcs, spirals, loose brush strokes, and glowing lines, with bright colors, creating a summer-travel mood. The cartoon character should match the original photo's lighting/perspective and blend naturally with it. The overall effect: a real photo with an added cartoon-sticker character of matching pose/outfit but taller, plus hand-drawn decorations, layered on top; strictly forbidden to alter the original person or original background — only add the cartoon figure and doodles.",
    "identityMode": "reinforced",
    "imageFile": "925bfb9a-4a95-4e22-9100-a864119f5f33.jpg",
    "enabled": true,
    "order": 28,
    "createdAt": "2026-07-22T02:09:26.396Z",
    "updatedAt": "2026-07-31T03:23:23.348Z",
    "categoryId": "4ed760a1-09f7-4274-aa0d-83a30ca389db",
    "titleZh": "真人與卡通分身",
    "promptZh": "完全保留原始人物——位置不變，臉部、髮型、體型比例、服裝、姿勢、站姿與照片質感全部不變；不得重新繪製或移動人物。保持背景、街邊綠植、光線與構圖與原圖完全一致，僅在畫面空白處加入新內容。在空白區域加入一個卡通角色，其服裝造型與姿勢方向須配合原人物；卡通角色的身高應佔畫面較大比例，站在左側，明顯比原人物高。使用可愛、平面、手繪貼紙插畫風格——粗黑輪廓線搭配柔和淺黃色描邊、馬卡龍色系平塗、圓潤可愛的表情與粉紅腮紅，呈現旅行手帳貼紙的風格。在人物周圍加入俏皮的手繪塗鴉裝飾：小巧繽紛的花朵、鏤空花朵輪廓、波浪線、短弧線、螺旋線、隨性筆觸與發光線條，色彩明亮，營造夏日旅行氛圍。卡通角色須配合原照片的光線與透視，自然融入畫面。整體效果：一張真實照片，加入一個姿勢／服裝相符但身形更高的卡通貼紙角色，並疊加手繪裝飾；嚴禁改變原人物或原背景——僅能加入卡通角色與塗鴉。"
  },
  {
    "id": "3ca46f44-6fd7-4020-b3f5-ff50b972e344",
    "title": "Giant Hand-drawn Cat Hug",
    "prompt": "A giant hand-drawn cat gently hugs the real person from above | Use case: exaggerated, funny, eye-catching social-media image. Fully preserve the original person — position unchanged, face, hairstyle, body proportions, clothing, pose, stance, and photo texture all unchanged; do not redraw or move the person. Keep the background, street greenery, lighting, and composition exactly as in the original, only adding new content into empty areas of the frame. Add one very large hand-drawn cat into the empty area of the frame; the cat leans down from above or from the upper side and gently hugs the original person with its front paws — the gesture is exaggerated but gentle, like a giant plush cat suddenly appearing and hugging the real person. The cat should not press down on the person or cover their main facial features; the person must remain fully visible and clear. Draw the cat in a cute, flat, hand-drawn sticker-illustration style — thick black outlines, a soft light-yellow outer stroke, macaron flat coloring, a round cute expression, pink blush, and bright expressive eyes. Render cat ears, whiskers, tail, and fur with simple hand-drawn lines; the overall feel should have the relaxed charm of a travel-journal sticker/doodle illustration. Add playful hand-drawn doodle decorations around the person: small colorful flowers, hollow flower outlines, wavy lines, short arcs, spirals, loose brush strokes, glowing lines, cat paw prints, little stars, and heart shapes, with bright colors and a cute, playful mood. The added cat needs to match the original photo's perspective, angle, and lighting, blending naturally with it. The overall effect: a real photo where a giant, cute, hand-drawn cat gently hugs the person from above. Do not generate: any change to the original person, moving the person, redrawing the person, changing the face/hairstyle/clothing/pose, changing the background/street greenery/lighting, turning the person into an illustration, a realistic cat, a fierce/aggressive cat expression, an injured-looking person, threatening/dangerous poses, covered facial features, or a cluttered image.",
    "identityMode": "reinforced",
    "imageFile": "aed7d2c6-5db1-488a-80ce-23eec38df891.jpg",
    "enabled": true,
    "order": 27,
    "createdAt": "2026-07-22T02:09:46.271Z",
    "updatedAt": "2026-07-31T03:23:23.352Z",
    "categoryId": "4ed760a1-09f7-4274-aa0d-83a30ca389db",
    "titleZh": "巨貓手繪擁抱",
    "promptZh": "一隻巨大的手繪貓咪從上方輕輕擁抱真人｜適用情境：誇張有趣、吸睛的社群媒體圖片。完全保留原始人物——位置不變，臉部、髮型、體型比例、服裝、姿勢、站姿與照片質感全部不變；不得重新繪製或移動人物。保持背景、街邊綠植、光線與構圖與原圖完全一致，僅在畫面空白處加入新內容。在畫面空白區域加入一隻體型非常巨大的手繪貓咪；貓咪從上方或側上方俯身而下，用前掌輕輕擁抱原人物——動作誇張卻溫柔，宛如一隻巨大的絨毛貓咪突然出現並擁抱真人。貓咪不應壓迫人物，也不得遮擋其主要五官；人物須保持完整清晰可見。以可愛、平面、手繪貼紙插畫風格繪製貓咪——粗黑輪廓線、柔和淺黃色外描邊、馬卡龍色系平塗、圓潤可愛的表情、粉紅腮紅，以及明亮有神的雙眼。以簡單的手繪線條呈現貓耳、鬍鬚、尾巴與毛髮；整體感覺應帶有旅行手帳貼紙／塗鴉插畫般的輕鬆魅力。在人物周圍加入俏皮的手繪塗鴉裝飾：小巧繽紛的花朵、鏤空花朵輪廓、波浪線、短弧線、螺旋線、隨性筆觸、發光線條、貓掌印、小星星與愛心圖案，色彩明亮，氛圍可愛俏皮。新加入的貓咪須配合原照片的透視、角度與光線，自然融入畫面。整體效果：一張真實照片中，一隻巨大可愛的手繪貓咪從上方輕輕擁抱人物。不要生成：改變原人物、移動人物、重新繪製人物、改變臉部／髮型／服裝／姿勢、改變背景／街邊綠植／光線、將人物變成插畫、寫實的貓、兇猛具攻擊性的貓表情、看似受傷的人物、具威脅性／危險的姿勢、遮擋五官，或畫面過於雜亂。"
  },
  {
    "id": "d732757f-2fbf-4ac8-a929-a4b30fd66325",
    "title": "Sticker Doodle",
    "prompt": "Transform the person as if a child stuck stickers on them and then scribbled over it. Rounded silhouette, exaggerated proportions, keep the original pose, but hands, feet, clothes, and face are simplified into naive, childlike shapes. Surround the image with wobbly little stars, hearts, food icons, arrows, and scrawled handwritten text. Coloring is uneven, as if quickly applied with markers. Keywords: kids' stickers, round chibi shapes, casual sticker placement, naive shapes, wobbly handwriting, food icons, uneven coloring, loose scribbly doodle.",
    "identityMode": "reinforced",
    "imageFile": "11fc5447-616c-4d42-9cef-cc1bd6fc6dc5.jpg",
    "enabled": true,
    "order": 26,
    "createdAt": "2026-07-22T02:10:03.520Z",
    "updatedAt": "2026-07-31T03:23:23.355Z",
    "categoryId": "4ed760a1-09f7-4274-aa0d-83a30ca389db",
    "titleZh": "貼紙塗鴉",
    "promptZh": "將人物轉變成彷彿被孩童貼上貼紙後又隨手塗鴉的效果。圓潤的輪廓、誇張的比例，保留原始姿勢，但雙手、雙腳、服裝與臉部皆簡化為稚拙童趣的造型。在畫面周圍環繞歪扭的小星星、愛心、食物圖示、箭頭與潦草的手寫文字。上色不均勻，彷彿以馬克筆快速塗抹而成。關鍵字：兒童貼紙、圓潤Q版造型、隨性貼紙擺放、稚拙造型、歪扭手寫字、食物圖示、不均勻上色、隨性潦草塗鴉。"
  },
  {
    "id": "60279a62-61ce-4676-8a4a-3a69301b380c",
    "title": "Crayon Sketch Doodle",
    "prompt": "Convert the photo's person into a playful, doodle-style sketch, keeping their original pose, hairstyle, clothing silhouette, and overall recognizability, while moderately exaggerating and distorting the facial features and expression. The overall look should feel like it was quickly and spontaneously drawn with cheap crayons or color markers — rough and messy, with the relaxed feel of raw hand-drawn art; proportions and perspective don't follow strict rules, and the lines look slightly clumsy. Outlines are loose and broken, with repeated strokes and overshooting lines typical of a rough draft; coloring is applied casually and unevenly, with irregular color-block edges and visible crayon texture. Pair with a simple cartoon-style background — simplified streets, trees, houses, etc. — with loose, sketchy lines that don't need much detail. Add common meme-style symbols where appropriate: question marks, exclamation marks, little stars, sweat-drop lines. The overall mood should be relaxed and humorous, with the casual spirit of an internet meme — as if dashed off spontaneously, not aiming for polish or completeness. Do not generate: photorealistic texture, refined heavy-paint illustration style, smooth and tidy vector lines, polished/beautified illustration, 3D cartoon characters, intricate detailed backgrounds, facial changes so drastic the person becomes unrecognizable, or commercial-poster quality.",
    "identityMode": "reinforced",
    "imageFile": "5dc56299-9c68-416b-a2d8-14f6fd7fff2f.jpg",
    "enabled": true,
    "order": 25,
    "createdAt": "2026-07-22T02:10:18.827Z",
    "updatedAt": "2026-07-31T03:23:23.360Z",
    "categoryId": "4ed760a1-09f7-4274-aa0d-83a30ca389db",
    "titleZh": "蠟筆塗鴉速寫",
    "promptZh": "將照片中的人物轉換為俏皮的塗鴉風速寫，保留其原始姿勢、髮型、服裝輪廓與整體可辨識度，同時適度誇張並扭曲五官與表情。整體觀感應如同以廉價蠟筆或彩色馬克筆快速隨性繪製而成——粗糙凌亂，帶有原始手繪的鬆弛感；比例與透視不拘泥於嚴謹規則，線條略顯笨拙。輪廓線鬆散斷續，帶有草稿般的重複筆觸與溢出線條；上色隨性不均勻，色塊邊緣不規則，並保留明顯的蠟筆質感。搭配簡單的卡通風格背景——簡化的街道、樹木、房屋等——線條隨性潦草，不需過多細節。適時加入常見的迷因風符號：問號、驚嘆號、小星星、汗滴線條。整體氛圍應輕鬆詼諧，帶有網路迷因般的隨性精神——彷彿隨手一揮而就，不追求精緻或完整。不要生成：寫實質感、精緻厚塗插畫風格、平滑工整的向量線條、精緻美化的插畫、3D卡通角色、繁複精細的背景、五官改變幅度過大導致無法辨識，或商業海報般的質感。"
  },
  {
    "id": "c9f1a384-7472-42e4-a0b5-6b81067bd4b2",
    "title": "Soft Clay Figure",
    "prompt": "Convert the person in the photo into a soft, cute 3D clay-figure portrait, keeping their original pose, hairstyle, clothing silhouette, direction of motion, and overall vibe. Apply a slight 'cute-ification' to the proportions — a rounder head-to-body ratio — and simplify the facial features into a soft 3D expression, while still keeping the person recognizable. The material should resemble handmade clay or polymer clay, with a subtle fine texture on the surface, soft rounded edges, and clothing folds/hair rendered as simplified solid 3D shapes. Keep the overall color palette bright and soft, with clean diffuse lighting — no photorealistic rendering. The background can be simplified to a small display stand, a plain-colored backdrop, or a relaxed everyday scene; keep the composition uncluttered. The overall feeling should be cute, comforting, like a small clay figurine handmade specifically from this photo. Do not generate: photorealistic human texture, overly exaggerated chibi distortion, overly plastic-looking 3D modeling, completely altered facial features, changed pose, missing clothing, complex realistic backgrounds, a strong commercial-ad feel, or low recognizability.",
    "identityMode": "reinforced",
    "imageFile": "9c0e21f5-3d28-40e8-9065-6d1ee7d98dcc.jpg",
    "enabled": true,
    "order": 24,
    "createdAt": "2026-07-22T02:10:33.819Z",
    "updatedAt": "2026-07-31T03:23:23.363Z",
    "categoryId": "38d3befa-39e5-47d4-bf0b-a140792b2ac3",
    "titleZh": "軟陶公仔",
    "promptZh": "將照片中的人物轉換為柔軟可愛的3D軟陶公仔肖像，保留其原始姿勢、髮型、服裝輪廓、動作方向與整體氛圍。將比例做輕微「可愛化」處理——頭身比例更圓潤——並將五官簡化為柔和的3D表情，同時仍保持人物可辨識。材質應呈現手工黏土或聚合物黏土的質感，表面帶有細緻紋理、柔和圓潤的邊緣，服裝皺褶與髮絲則以簡化的立體塊面呈現。整體色調保持明亮柔和，搭配乾淨的漫射光線——不採用寫實渲染。背景可簡化為小型展示台、純色背景，或輕鬆的日常場景；保持構圖簡潔不雜亂。整體感覺應可愛療癒，宛如專為這張照片手工捏製的小巧黏土公仔。不要生成：寫實人體質感、過度誇張的Q版變形、過於塑膠感的3D建模、五官完全改變、姿勢改變、服裝缺失、複雜寫實背景、強烈商業廣告感，或辨識度過低。"
  },
  {
    "id": "378c6b79-c27f-4dbb-a9f3-1ceeb7973f8f",
    "title": "Witty Comic Strip",
    "prompt": "Convert this portrait photo into a single, funny comic-strip panel, keeping the person's facial features and pose, their original facial characteristics, hairstyle, clothing silhouette, and direction of motion — the main subject's identity must not change. The overall feel should be a loose, sketchy comic-strip draft, as if cut from a single frame of a lighthearted daily comic strip. Draw the person with thick black hand-drawn outlines — lines should be shaky, broken, with repeated strokes; avoid clean, tidy vector lines. Use flat coloring with simple, bright color blocks, allowing some color bleed, uneven edges, and visible hand-drawn traces. Exaggerate the expression — eyes, mouth, eyebrows, and facial muscles dramatically distorted — to convey shock, speechlessness, sudden excitement, a laugh-cry moment, or general comedic everyday vibe. Add classic comic-strip elements: speed lines, sound-effect text bubbles, sweat-drop lines, little shock symbols, exaggerated exclamation/question marks, halftone dots, and partial hatching. Keep the composition casual, like a spontaneously captured, memorable, funny moment — not too polished, not too complete, not too clean. The overall style should be relaxed, humorous, and full of everyday charm — a comic-strip-style portrait illustration that keeps the real person recognizable while placing them in an exaggerated comic scenario. Do not use heavy refined painting, realistic lighting, a clean undecorated look, over-beautification, photorealism, or a plain filter effect. Do not generate: refined heavy-paint style, realistic lighting, a clean undecorated image, plain illustration filters, over-beautification, photorealistic texture, 3D cartoon, an overly polished/pretty comic face, a complete detailed background, commercial-poster feel, low recognizability, missing facial features, changed pose, or the person turning into someone else.",
    "identityMode": "reinforced",
    "imageFile": "b22f7eae-e317-4166-b98d-ec9ab8ad8897.jpg",
    "enabled": true,
    "order": 23,
    "createdAt": "2026-07-22T02:10:52.719Z",
    "updatedAt": "2026-07-31T03:23:23.367Z",
    "categoryId": "89d3d50f-6ef4-437c-95c0-c799f8fb6440",
    "titleZh": "詼諧條漫",
    "promptZh": "將這張肖像照轉換為單格爆笑條漫畫面，保留人物的五官與姿勢、原始臉部特徵、髮型、服裝輪廓與動作方向——主體身份不得改變。整體感覺應呈現鬆散隨性的條漫草稿感，彷彿從一部輕鬆日常條漫中截取的單一畫格。以粗黑手繪輪廓線描繪人物——線條應顫抖斷續、帶有重複筆觸；避免乾淨工整的向量線條。使用平塗上色，色塊簡單明亮，允許些微顏色溢出、邊緣不齊與明顯的手繪痕跡。誇張化表情——雙眼、嘴巴、眉毛與臉部肌肉大幅扭曲變形——以傳達震驚、無語、突然興奮、又哭又笑，或日常喜劇氛圍。加入經典條漫元素：速度線、狀聲詞對話框、汗滴線條、小型震驚符號、誇張的驚嘆號／問號、網點，以及局部排線。保持構圖隨性，宛如隨手捕捉到的難忘爆笑瞬間——不過於精緻、不過於完整、不過於乾淨。整體風格應輕鬆詼諧、充滿生活化魅力——一幅條漫風格的人像插畫，讓真人保持可辨識，同時置入誇張的漫畫情境中。不要使用精緻厚塗、寫實光影、乾淨無裝飾的畫面、過度美化、寫實質感，或單純的濾鏡效果。不要生成：精緻厚塗風格、寫實光影、乾淨無裝飾的畫面、單純的插畫濾鏡、過度美化、寫實質感、3D卡通、過於精緻美化的漫畫臉、完整精細的背景、商業海報感、辨識度過低、五官缺失、姿勢改變，或人物變成另一個人。"
  },
  {
    "id": "ca88a710-b87f-4192-a72a-6f16396d55bf",
    "title": "Hand-drawn Sketch Portrait",
    "prompt": "Convert this portrait photo into a loose, casual hand-drawn sketch, based on the person's pose and facial features from the photo, using a shaky black ink pen to draw a single-line outline — lines are repeated and broken, imperfections aren't corrected, giving it the relaxed feel of a casual doodle. Apply light watercolor-marker coloring casually, letting the color bleed past the outlines with uneven color blocks. Add hand-drawn decorations in the empty areas of the image: explosion-style speech bubbles, handwritten stream-of-consciousness mood text, circled arrows, wavy lines, sweat-drop symbols, little ghosts, and heart doodles. Slightly and casually distort body proportions — don't use strict perspective. The overall mood should feel like an impromptu emotional doodle in a notebook — rough, lively, full of internet-meme charm. Do not generate: neat smooth line art, delicate realistic lighting, refined complete coloring, a clean clutter-free background, over-beautified subjects, photorealistic texture, 3D rendering effects, complex complete scenes, a commercial-illustration feel, or an overly cluttered image.",
    "identityMode": "reinforced",
    "imageFile": "9310b2be-6885-4f28-b857-feb9c4aae574.jpg",
    "enabled": true,
    "order": 22,
    "createdAt": "2026-07-22T02:11:07.335Z",
    "updatedAt": "2026-07-31T03:23:23.372Z",
    "categoryId": "4ed760a1-09f7-4274-aa0d-83a30ca389db",
    "titleZh": "手繪速寫肖像",
    "promptZh": "將這張肖像照轉換為鬆散隨性的手繪速寫，依據照片中人物的姿勢與五官為基礎，以顫抖的黑色墨水筆繪製單線輪廓——線條重複斷續，不修正瑕疵，呈現隨性塗鴉般的鬆弛感。隨性地施加淡彩水彩馬克筆上色，讓顏色溢出輪廓線，形成不均勻的色塊。在畫面空白處加入手繪裝飾：爆炸式對話框、手寫的意識流情緒文字、圈起來的箭頭、波浪線、汗滴符號、小幽靈與愛心塗鴉。輕微且隨性地扭曲身體比例——不採用嚴謹透視。整體氛圍應如同在筆記本上即興抒發情緒的塗鴉——粗糙、生動，充滿網路迷因般的魅力。不要生成：工整平滑的線稿、精緻寫實的光影、精緻完整的上色、乾淨無雜物的背景、過度美化的主體、寫實質感、3D渲染效果、複雜完整的場景、商業插畫感，或畫面過於雜亂。"
  },
  {
    "id": "58fffb39-98fe-4b6b-b1da-a5ff55d7b02d",
    "title": "Cartoon Sticker",
    "prompt": "Cartoon sticker-style illustration with a crisp, thick black outline, bright flat coloring, and soft, simple shading. The portrait has a built-in white sticker border, with the scene scattered with torn tape pieces, geometric color blocks, hollow stars, and speech-bubble text. Slightly exaggerate the expression; the style should feel lively and bright, similar to trendy sticker illustrations on social platforms. Do not generate: gradient oil-painting texture, realistic skin texture, dark/dull color tones, heavy complex backgrounds, messy noise, delicate realistic hair, or realistic lighting/shading.",
    "identityMode": "reinforced",
    "imageFile": "e17c8138-77bb-4b39-82a0-b95378804873.jpg",
    "enabled": true,
    "order": 21,
    "createdAt": "2026-07-22T02:11:19.838Z",
    "updatedAt": "2026-07-31T03:23:23.376Z",
    "categoryId": "89d3d50f-6ef4-437c-95c0-c799f8fb6440",
    "titleZh": "卡通貼紙",
    "promptZh": "卡通貼紙風格插畫，帶有俐落粗黑輪廓線、明亮平塗色彩，以及柔和簡單的陰影。人像自帶白色貼紙邊框，畫面散布撕裂膠帶碎片、幾何色塊、鏤空星星與對話框文字。表情略微誇張；風格應呈現活潑明亮的觀感，類似社群平台上流行的貼紙插畫。不要生成：漸層油畫質感、寫實皮膚質感、深沉黯淡的色調、繁重複雜的背景、雜亂噪點、精緻寫實的毛髮，或寫實光影。"
  },
  {
    "id": "83586d3c-cb31-4a54-be54-6fa5ae31b780",
    "title": "Vintage Magazine Collage",
    "prompt": "Using the person in the photo as the subject, create a vintage fashion-magazine torn-paper collage artwork. The portrait subject looks as if it were torn out of a 1990s fashion magazine, with rough, irregular paper edges and natural drop shadows where paper pieces overlap. Pair the background with scattered newspaper text fragments, colored paper strips, and staple marks. Use colored markers to add hand-drawn annotations, arrows, short handwritten notes, and simple line decorations in the empty areas. The overall tone should be slightly yellowed and aged, keeping a candid, relaxed feel — artsy, vintage, and full of hand-made DIY charm. Do not generate: a fully smooth seamless image, glossy digital texture, a neat clean composition, overly vibrant modern colors, perfectly cropped edges, 3D rendering, uniform lighting, a CG look, overly polished rendering, or seamless compositing.",
    "identityMode": "reinforced",
    "imageFile": "2a0eca7f-1115-458b-bd01-4886e03ef3e8.jpg",
    "enabled": true,
    "order": 20,
    "createdAt": "2026-07-22T02:11:46.237Z",
    "updatedAt": "2026-07-31T03:25:27.100Z",
    "categoryId": "6ad0a676-4347-4eb6-9db1-7b3938f373ae",
    "titleZh": "復古雜誌拼貼",
    "promptZh": "以照片中的人物為主體，創作一幅復古時尚雜誌撕紙拼貼藝術作品。人像主體看起來彷彿是從1990年代時尚雜誌上撕下來的，帶有粗糙不規則的紙張邊緣，以及紙片重疊處自然形成的投影。搭配散落的報紙文字碎片、彩色紙條與訂書針痕跡作為背景。使用彩色馬克筆在空白處加入手繪註記、箭頭、簡短手寫筆記與簡單的線條裝飾。整體色調應略帶泛黃做舊感，保持隨性自然的氛圍——富有藝術感、復古，並充滿手工DIY的魅力。不要生成：完全平滑無縫的畫面、光滑的數位質感、工整乾淨的構圖、過於鮮豔的現代色彩、完美裁切的邊緣、3D渲染、均勻光線、CG質感、過度精緻的渲染，或無縫合成的效果。"
  },
  {
    "id": "67b8ae3a-6d78-433d-9b4a-47251af82771",
    "title": "Anime Figure in Box",
    "prompt": "Transform the person into a highly detailed collectible anime/nendoroid-style figure, displayed inside clear plastic blister packaging like a boxed action figure. Keep the person's pose, facial expression, hairstyle, clothing silhouette, and overall identity recognizable, rendered in a glossy PVC-figure material with smooth painted surfaces, soft cel-shaded highlights, and visible plastic sheen. Give the figure cute, slightly stylized proportions typical of collectible figures — slightly larger eyes, smooth simplified facial detail — while keeping the person clearly recognizable. Place the figure standing on a small circular plastic base with a printed logo-style label. Surround it with realistic blister-pack packaging: a clear plastic dome or window, printed cardboard backing with soft gradient background art, small printed text blocks and barcode-style graphic elements (illegible/generic, not real text), and one or two accessory pieces (like a small prop or interchangeable hand) tucked in a plastic tray beside the figure. Lighting should look like a product photo — soft studio lighting, subtle shadow beneath the packaging, slight reflective highlight on the plastic. Do not generate: realistic human skin texture on the figure, a fully photographic person, blurry or low-detail packaging, a different pose or outfit than the original, loss of facial identity, or a cluttered background outside the packaging.",
    "identityMode": "reinforced",
    "imageFile": "7569ff6f-8b96-40f5-8e46-8fc96f46e708.jpg",
    "enabled": true,
    "order": 19,
    "createdAt": "2026-07-24T02:02:33.799Z",
    "updatedAt": "2026-07-31T03:25:27.111Z",
    "categoryId": "38d3befa-39e5-47d4-bf0b-a140792b2ac3",
    "titleZh": "動漫盒裝公仔",
    "promptZh": "將人物轉變為高細節的收藏級動漫／Q版公仔，展示於透明塑膠吸塑包裝中，如同盒裝的動作人偶。保留人物的姿勢、面部表情、髮型、服裝輪廓與整體身份可辨識度，以光澤PVC公仔材質呈現，表面平滑上色、帶有柔和的賽璐璐上色高光與明顯的塑膠光澤。賦予公仔可愛、略微風格化的收藏級比例——稍大的雙眼、平滑簡化的五官細節——同時保持人物清晰可辨識。讓公仔站立於印有品牌標誌風格標籤的小型圓形塑膠底座上。周圍搭配寫實的吸塑包裝：透明塑膠圓頂或視窗、印有柔和漸層背景圖案的紙板底卡、印刷文字區塊與條碼風格的圖形元素（模糊或通用，非真實文字），以及一兩個放在塑膠托盤中的配件（如小道具或可替換的手部）。燈光應呈現如商品攝影般的效果——柔和棚燈、包裝下方的細膩陰影，以及塑膠表面的輕微反光。不要生成：公仔上的寫實人體皮膚質感、完全照片寫實的人物、模糊或細節不足的包裝、與原始不同的姿勢或服裝、面部身份的喪失，或包裝外雜亂的背景。"
  },
  {
    "id": "4a621fed-1eab-452d-a44e-c77a7910a86f",
    "title": "LEGO Minifigure",
    "prompt": "Rebuild the person as a LEGO minifigure, keeping their pose, hairstyle silhouette, clothing colors/design, and overall identity recognizable within LEGO's iconic block style. Use a cylindrical head (yellow, or skin-toned if closer to the original) with minimal simplified facial features printed in the flat LEGO graphic style, a blocky trapezoidal torso printed with the person's clothing design, simplified block arms and hands with the classic claw-shaped LEGO hand, and short block legs matching the original pants/clothing color. Hair or hats should be modeled as a separate glossy LEGO hairpiece/hat accessory shaped to match the original hairstyle. Keep the plastic look glossy and smooth, with the characteristic LEGO stud visible on top of the head if hatless. Place the figure standing on a LEGO baseplate, either alone or with a couple of small simple LEGO-brick props relevant to the original photo's setting. The background can be a plain, softly lit studio backdrop or a simplified brick-built scene echoing the original environment. Do not generate: realistic human skin or hair texture, a fully photographic figure, loss of the original pose or outfit colors, unrecognizable identity, or a cluttered/realistic background.",
    "identityMode": "reinforced",
    "imageFile": "c5477126-b0d7-4591-a673-417688e2ee28.jpg",
    "enabled": true,
    "order": 18,
    "createdAt": "2026-07-24T02:02:33.810Z",
    "updatedAt": "2026-07-31T03:25:27.115Z",
    "categoryId": "38d3befa-39e5-47d4-bf0b-a140792b2ac3",
    "titleZh": "樂高小人偶",
    "promptZh": "將人物重新打造為樂高小人偶，保留其姿勢、髮型輪廓、服裝顏色／設計與整體身份，並融入樂高標誌性的積木造型風格。使用圓柱形頭部（黃色，或若更接近原圖則使用膚色），以樂高平面圖案風格印上極簡化的五官，梯形塊狀身軀印有人物的服裝設計，簡化的塊狀手臂與經典樂高鉤爪形狀的雙手，以及與原始褲裝／服裝顏色相符的短塊狀雙腿。頭髮或帽子應建模為獨立的光澤樂高髮件／帽子配件，造型須符合原始髮型。保持塑膠質感光滑有光澤，若未戴帽則頭頂應可見樂高標誌性的凸點。讓公仔站立於樂高底板上，可單獨呈現，或搭配一兩個與原照片場景相關的簡單樂高積木道具。背景可為簡單柔光棚拍背景，或呼應原始環境的簡化積木搭建場景。不要生成：寫實的人體皮膚或毛髮質感、完全照片寫實的公仔、原始姿勢或服裝顏色的喪失、無法辨識的身份，或雜亂寫實的背景。"
  },
  {
    "id": "99ef2b26-20c1-4613-b797-279f4a0801c5",
    "title": "Watercolor Portrait",
    "prompt": "Convert the photo into a soft, hand-painted watercolor portrait, preserving the person's pose, facial features, hairstyle, and clothing silhouette so they remain clearly recognizable. Use loose, flowing watercolor brushwork with visible pigment blooms, soft color bleeding at edges, and gentle gradients rather than hard outlines. Keep a light, airy color palette with occasional deeper pigment pooling for shadow areas, and leave visible white paper texture showing through in highlight areas. Facial features should be softly rendered — simplified but still expressive and identifiable — built mostly from color washes with minimal hard linework. The background should be minimal: a soft wash of complementary color, a light paper-texture vignette, or a loosely suggested environment echoing the original setting, without hard edges or fine detail. Overall mood: gentle, artistic, and light-filled, like a traditional watercolor portrait painted from life. Do not generate: photorealistic texture, hard vector outlines, flat cartoon coloring, 3D rendering, digital airbrush smoothness, or loss of the person's recognizable identity.",
    "identityMode": "reinforced",
    "imageFile": "c2df4334-6201-4bb7-935f-e3cbba1988b8.jpg",
    "enabled": true,
    "order": 17,
    "createdAt": "2026-07-24T02:02:33.817Z",
    "updatedAt": "2026-07-31T03:25:27.118Z",
    "categoryId": "d7f9ac70-0439-42da-b4c2-10a929998ad8",
    "titleZh": "水彩肖像",
    "promptZh": "將照片轉換為柔和的手繪水彩肖像，保留人物的姿勢、五官、髮型與服裝輪廓，使其保持清晰可辨識。運用鬆散流動的水彩筆觸，帶有明顯的顏料暈染、邊緣柔和的色彩暈開，以及柔和的漸層而非硬邊輪廓線。保持輕盈通透的色調，陰影處偶爾出現較深的顏料堆積，並在高光處保留可見的白色紙張紋理。五官應柔和呈現——簡化但仍具表現力且可辨識——主要以色彩暈染構成，僅有極少的硬邊線條。背景應保持極簡：一抹柔和的互補色暈染、淡淡的紙張紋理暈影，或呼應原始場景的鬆散環境暗示，不含硬邊或精細細節。整體氛圍：柔和、藝術感、充滿光線，宛如寫生而成的傳統水彩肖像。不要生成：寫實質感、生硬的向量輪廓線、平面卡通上色、3D渲染、數位噴槍般的平滑感，或人物可辨識身份的喪失。"
  },
  {
    "id": "eefd8335-35b4-4d37-9192-7e7e7bfd0214",
    "title": "Cyberpunk Neon",
    "prompt": "Transform the scene into a moody cyberpunk night-city portrait, keeping the person's pose, facial features, hairstyle, and clothing silhouette recognizable. Light the person primarily with vivid neon rim lighting — magenta, cyan, and electric-blue accents wrapping the edges of their face, hair, and clothing — against a dark, high-contrast background. Add subtle futuristic wardrobe accents consistent with the original outfit (a glossy jacket sheen, a faint holographic patch, or reflective material highlights) without fully replacing their actual clothing. The background should suggest a rain-slicked futuristic city street or alley at night: blurred neon signage, glowing window reflections, soft atmospheric haze, and bokeh light spots, all kept out of sharp focus so the person stays the clear subject. Add fine film-grain texture and slightly elevated contrast for a cinematic night-photography feel. Preserve the person's recognizable identity and expression throughout. Do not generate: daytime lighting, cartoon/anime style, flat illustration coloring, loss of facial identity, or an overly busy background that competes with the subject.",
    "identityMode": "reinforced",
    "imageFile": "2220c60e-5009-4513-8ddf-130f76a6a3eb.jpg",
    "enabled": true,
    "order": 16,
    "createdAt": "2026-07-24T02:02:33.819Z",
    "updatedAt": "2026-07-31T03:25:27.123Z",
    "categoryId": "d1c0c307-f729-4b82-863c-76b25cb2a890",
    "titleZh": "賽博龐克霓虹",
    "promptZh": "將場景轉變為氛圍濃厚的賽博龐克夜城肖像，保留人物的姿勢、五官、髮型與服裝輪廓的可辨識度。以鮮明的霓虹輪廓光為主要光源照亮人物——洋紅、青色與電光藍的光暈環繞其臉部、頭髮與服裝邊緣——襯托深色高對比的背景。加入細膩的未來感服裝點綴，與原始服裝保持一致（光澤外套質感、若隱若現的全息貼片，或反光材質高光），但不完全替換其實際服裝。背景應暗示雨後濕潤的未來城市街道或深夜巷弄：模糊的霓虹招牌、發光的窗戶反射、柔和的氛圍薄霧，以及散景光點，皆保持失焦狀態，讓人物維持清晰主體地位。加入細緻的膠片顆粒質感與略微提升的對比度，營造電影感的夜拍氛圍。全程保留人物可辨識的身份與表情。不要生成：日間光線、卡通／動漫風格、平面插畫上色、面部身份的喪失，或與主體互相搶戲的過於繁雜背景。"
  },
  {
    "id": "351ca054-161d-4ff8-b3b2-fd575bfc9d0a",
    "title": "Pixel Art Sprite",
    "prompt": "Convert the person into a retro 8-bit/16-bit style pixel-art game character sprite, preserving their pose, hairstyle silhouette, clothing colors, and overall recognizable identity within the constraints of the pixel-art medium. Use a limited, cohesive color palette with visible individual square pixels, hard-edged color blocks, and no anti-aliasing or gradients — flat dithered shading only where appropriate for the retro game era being evoked. Simplify facial features into minimal, iconic pixel shapes while keeping the character type recognizable (hair color/style, skin tone, outfit colors, accessories). Render the character standing in a simple sprite-sheet-style pose against a plain or lightly patterned retro game background — suggesting a simplified environment echoing the original photo's setting using large flat pixel blocks (sky, ground line, a few background elements). Optionally include a thin pixelated UI-style border or platform ledge beneath the character's feet, evoking a classic side-scrolling game. Do not generate: smooth gradients, photorealistic shading, anti-aliased edges, high pixel-density/high-resolution rendering, 3D depth effects, or loss of the person's recognizable identity.",
    "identityMode": "reinforced",
    "imageFile": "90c05937-010b-4147-99b7-676ec3902831.jpg",
    "enabled": true,
    "order": 15,
    "createdAt": "2026-07-24T02:02:33.821Z",
    "updatedAt": "2026-07-31T03:25:27.128Z",
    "categoryId": "d1c0c307-f729-4b82-863c-76b25cb2a890",
    "titleZh": "像素藝術角色",
    "promptZh": "將人物轉換為復古8位元／16位元風格的像素藝術遊戲角色精靈圖，在像素藝術媒材的限制下保留其姿勢、髮型輪廓、服裝顏色與整體可辨識身份。使用有限且協調的色盤，呈現清晰可見的方形像素、硬邊色塊，不使用抗鋸齒或漸層——僅在符合所呈現復古遊戲年代時使用平面抖動陰影。將五官簡化為極簡且具代表性的像素造型，同時保持角色類型可辨識（髮色／髮型、膚色、服裝顏色、配件）。將角色以簡單的精靈圖姿勢呈現，背景為單純或帶輕微圖案的復古遊戲背景——以大塊平面像素（天空、地面線、幾個背景元素）暗示呼應原照片場景的簡化環境。可選擇性地在角色腳下加入細薄的像素風UI邊框或平台邊緣，呼應經典橫向捲軸遊戲的風格。不要生成：平滑漸層、寫實陰影、抗鋸齒邊緣、高像素密度／高解析度渲染、3D立體效果，或人物可辨識身份的喪失。"
  },
  {
    "id": "dbffcd13-afb3-4ade-acb2-b9156bf77232",
    "title": "Manga Panel",
    "prompt": "Convert the photo into a black-and-white manga-style illustration panel, preserving the person's pose, facial features, hairstyle, and clothing silhouette so their identity remains clearly recognizable. Use clean but expressive manga inking: confident black linework with varying weight, sharp linear shading, and classic manga screentone dot patterns for shadows and midtones instead of continuous grayscale shading. Render the eyes in a manga style — slightly enlarged and detailed with characteristic highlight dots — while keeping proportions grounded enough that the person is still recognizable, not a fully generic anime face. Add dramatic manga paneling elements where appropriate: a speed-line burst behind the subject for energy, or a soft screentone gradient background; keep any panel border thin and black like a printed manga page. Maintain strict black, white, and gray tones only — no color. Preserve the person's expression and identity throughout. Do not generate: full color, painterly shading, photorealistic rendering, 3D effects, a generic/unrecognizable anime face, or a cluttered multi-panel layout.",
    "identityMode": "reinforced",
    "imageFile": "30f9eba7-2f49-4b07-ad02-367b3f36f2c4.jpg",
    "enabled": true,
    "order": 14,
    "createdAt": "2026-07-24T02:02:33.824Z",
    "updatedAt": "2026-07-31T03:25:27.134Z",
    "categoryId": "89d3d50f-6ef4-437c-95c0-c799f8fb6440",
    "titleZh": "漫畫分格",
    "promptZh": "將照片轉換為黑白漫畫風格的插畫分格，保留人物的姿勢、五官、髮型與服裝輪廓，使其身份保持清晰可辨識。運用乾淨卻富有表現力的漫畫描線：粗細變化自信的黑色線條、銳利的線性陰影，以及經典漫畫網點圖案來呈現陰影與中間調，而非連續的灰階陰影。以漫畫風格呈現雙眼——略微放大並帶有典型的高光點細節——同時保持比例足夠寫實，讓人物依然可辨識，而非變成完全通用的動漫臉孔。適時加入戲劇性的漫畫分格元素：人物背後爆發的速度線以增添動感，或柔和的網點漸層背景；分格邊框應保持細薄黑色，如同印刷漫畫頁面。嚴格維持黑、白、灰三色調——不使用彩色。全程保留人物的表情與身份。不要生成：全彩、繪畫式陰影、寫實渲染、3D效果、通用且無法辨識的動漫臉，或雜亂的多格版面。"
  },
  {
    "id": "55e0a288-eea8-42b5-a353-8ede12f5561a",
    "title": "Professional Studio Headshot",
    "prompt": "Retouch and reframe the photo into a polished, professional studio headshot suitable for a corporate profile or LinkedIn photo, while fully preserving the person's real facial identity, expression style, hairstyle, and skin tone — this should look like the same real person, professionally photographed, not an illustration. Apply clean, even studio lighting with a soft key light and gentle fill, removing harsh shadows or uneven lighting from the original photo. Replace the background with a smooth, softly graduated solid backdrop (neutral gray, soft blue, or warm beige) with a subtle vignette, keeping the subject in sharp focus against a naturally blurred, professional depth-of-field feel. Keep retouching natural and subtle — even skin tone and reduced blemishes are fine, but do not smooth away real texture entirely or alter facial structure. Adjust framing to a standard head-and-shoulders composition suitable for professional use, straightening the crop and centering the subject if needed. Preserve the person's actual clothing, though wrinkles may be subtly reduced for a tidier look. Do not generate: cartoon or illustrated style, exaggerated features, heavy beautification or plastic-looking skin, a changed identity, casual/cluttered backgrounds, or dramatic artistic lighting effects.",
    "identityMode": "reinforced",
    "imageFile": "a573c87a-20c9-4d4a-8610-889b9c2ead4f.jpg",
    "enabled": true,
    "order": 13,
    "createdAt": "2026-07-24T02:02:33.826Z",
    "updatedAt": "2026-07-31T03:25:27.140Z",
    "categoryId": "aab9b995-1170-4176-a8c5-2d6748caf430",
    "titleZh": "專業棚拍形象照",
    "promptZh": "將照片修飾並重新構圖為精緻的專業棚拍形象照，適合企業檔案照或LinkedIn個人照使用，同時完全保留人物真實的臉部身份、表情風格、髮型與膚色——成品應呈現如同同一位真人經過專業攝影，而非插畫。運用乾淨均勻的棚燈，搭配柔和的主光與輕柔補光，去除原照片中生硬的陰影或不均勻光線。將背景替換為平滑柔和漸層的純色背景（中性灰、柔和藍或暖米色），並帶有淡淡的暈影，讓主體保持銳利對焦，並呈現自然柔化的專業景深效果。修飾應保持自然細膩——均勻膚色與減少瑕疵是可接受的，但不得完全抹去真實質感或改變臉部結構。將構圖調整為適合專業用途的標準頭肩比例，並視需要拉正裁切與置中主體。保留人物實際的服裝，但可適度減少皺褶以呈現更整潔的效果。不要生成：卡通或插畫風格、誇張的五官、過度美化或塑膠感的皮膚、身份改變、隨性雜亂的背景，或戲劇化的藝術光效。"
  },
  {
    "id": "32abbc7e-c452-437d-bfab-46b469da843d",
    "title": "Stained Glass Portrait",
    "prompt": "Transform the person into a stained-glass window artwork, preserving their pose, facial features, hairstyle, and clothing silhouette so they remain clearly recognizable. Break the image into bold, segmented color panels separated by thick black leaded lines, in the style of a traditional stained-glass window. Use rich, jewel-toned translucent colors — deep blues, emerald greens, ruby reds, golden yellows — with each segment a flat, saturated color rather than realistic shading; add subtle internal texture within each glass segment (light cracks, color variation) to suggest real glass. Light the whole image as if backlit by sunlight streaming through the glass, with soft glowing highlights radiating from lighter segments. Keep facial features simplified into clean glass-panel shapes while still preserving a recognizable likeness. The background should be simplified into a few larger stained-glass segments echoing the setting, all leaded in the same black-line style. Do not generate: photorealistic shading, smooth photographic gradients, a fully monochrome image, cartoon/anime coloring, or loss of the person's recognizable identity.",
    "identityMode": "reinforced",
    "imageFile": "2a8e5ac4-7fec-4575-9dab-16b930b8c554.jpg",
    "enabled": true,
    "order": 12,
    "createdAt": "2026-07-24T02:04:18.350Z",
    "updatedAt": "2026-07-31T03:25:27.145Z",
    "categoryId": "d7f9ac70-0439-42da-b4c2-10a929998ad8",
    "titleZh": "彩繪玻璃肖像",
    "promptZh": "將人物轉變為彩繪玻璃窗藝術作品，保留其姿勢、五官、髮型與服裝輪廓，使其保持清晰可辨識。將畫面分割成大膽的分段色塊，以粗黑鉛條線分隔，呈現傳統彩繪玻璃窗的風格。使用濃郁的寶石色調半透明色彩——深藍、翡翠綠、寶石紅、金黃色——每個分段呈現平面飽和的色彩，而非寫實陰影；在每片玻璃分段內加入細微的內部紋理（細小裂痕、色彩變化）以呈現真實玻璃質感。將整體畫面以陽光穿透玻璃般的逆光呈現，柔和的光暈從較亮的分段向外散發。將五官簡化為乾淨的玻璃面板造型，同時保留可辨識的相似度。背景應簡化為幾個呼應場景的較大彩繪玻璃分段，皆以相同的黑線鉛條風格呈現。不要生成：寫實陰影、平滑的攝影漸層、完全單色的畫面、卡通／動漫上色，或人物可辨識身份的喪失。"
  },
  {
    "id": "2a097af9-2953-4a15-baa3-503dc15c1a1e",
    "title": "Classical Statue",
    "prompt": "Reimagine the person as a classical bronze or carved marble statue, preserving their pose, facial structure, hairstyle silhouette, and expression so they remain recognizable, adapted into a dignified, monumental sculptural stance. Render the surface as a single uniform sculptural material — either weathered bronze with a deep green-brown patina and subtle metallic highlights, or pale marble with soft veining and a matte stone finish (choose whichever suits the lighting best) — removing all color from skin, hair, and clothing, unifying everything into the sculpture's material. Clothing folds and hair should be carved into smooth, simplified sculptural forms rather than fine photographic detail. Light the statue dramatically, as if displayed outdoors or in a museum hall, with strong directional light creating deep shadows in the folds and a soft ambient glow on raised surfaces. Place the figure on a simple stone pedestal or plinth, with a softly blurred museum or plaza backdrop. Preserve the person's recognizable facial structure and pose throughout. Do not generate: full color, photographic skin texture, cartoon or illustration style, glossy plastic material, or loss of the person's recognizable identity.",
    "identityMode": "reinforced",
    "imageFile": "ca861360-7f35-4d14-9f15-3b1b47c3ca84.jpg",
    "enabled": true,
    "order": 11,
    "createdAt": "2026-07-24T02:04:18.352Z",
    "updatedAt": "2026-07-31T03:25:27.153Z",
    "categoryId": "38d3befa-39e5-47d4-bf0b-a140792b2ac3",
    "titleZh": "古典雕像",
    "promptZh": "將人物重新想像為古典青銅或雕刻大理石雕像，保留其姿勢、臉部結構、髮型輪廓與表情，使其保持可辨識，並轉化為莊嚴宏偉的雕塑姿態。將表面呈現為單一均勻的雕塑材質——可選擇帶有深綠棕色銅鏽與細膩金屬光澤的風化青銅，或帶有柔和紋理與霧面石材質感的淺色大理石（依光線效果擇一）——去除皮膚、頭髮與服裝的所有色彩，將一切統一於雕塑材質之中。服裝皺褶與頭髮應雕刻為平滑簡化的雕塑造型，而非精細的照片級細節。以戲劇性的方式為雕像打光，彷彿陳列於戶外或博物館大廳，強烈的定向光線在皺褶處形成深邃陰影，並在凸起表面產生柔和的環境光暈。將人物置於簡單的石製基座或台座上，背景為柔和模糊的博物館或廣場場景。全程保留人物可辨識的臉部結構與姿勢。不要生成：全彩、照片寫實的皮膚質感、卡通或插畫風格、光澤塑膠材質，或人物可辨識身份的喪失。"
  },
  {
    "id": "57e36464-9183-4f90-8822-07b5921adc8d",
    "title": "Embroidery Patch",
    "prompt": "Convert the photo into a stitched embroidery patch, preserving the person's pose, facial features, hairstyle, and clothing silhouette so they remain clearly recognizable within the constraints of embroidered thread art. Render every surface using visible thread texture — dense, directional satin stitches for larger areas, fine detail stitching for facial features, and slightly raised, fuzzy fiber texture throughout, as if machine-embroidered onto felt or twill fabric. Use a simplified, moderately saturated color palette suited to embroidery thread (avoid ultra-fine gradients; blend color transitions with visible stitch-direction changes instead). Outline the entire figure with a bold embroidered border stitch, and give the whole image a rounded or scalloped patch-shaped edge with a visible fabric-colored border, as if it's a sew-on patch. Add a couple of small decorative embroidered elements in the background echoing the original setting (simple stitched shapes, no readable text) kept subordinate to the main figure. Preserve the person's recognizable pose and features throughout. Do not generate: smooth photographic texture, flat vector coloring, 3D rendering, painterly brushwork, or loss of the person's recognizable identity.",
    "identityMode": "reinforced",
    "imageFile": "3579a16f-7dfc-4907-85dd-633e99003ce6.jpg",
    "enabled": true,
    "order": 10,
    "createdAt": "2026-07-24T02:04:18.354Z",
    "updatedAt": "2026-07-31T03:27:29.532Z",
    "categoryId": "6ad0a676-4347-4eb6-9db1-7b3938f373ae",
    "titleZh": "刺繡貼布",
    "promptZh": "將照片轉換為手工刺繡貼布，保留人物的姿勢、五官、髮型與服裝輪廓，使其在刺繡線藝的限制下依然清晰可辨識。以可見的繡線紋理呈現每個表面——較大面積使用密集有方向性的緞面繡，五官細節則以精細繡法呈現，整體帶有微微凸起、毛絨般的纖維質感，彷彿以機繡繡在毛氈或斜紋布上。使用簡化、飽和度適中、適合繡線表現的色盤（避免極細緻的漸層；改以可見的繡線方向變化來呈現色彩過渡）。以粗大的刺繡邊框線描繪整個人物輪廓，並讓整張圖呈現圓弧或扇貝形的貼布邊緣，帶有明顯的布料色邊，如同一片縫製貼布。在背景加入一兩個小型裝飾性刺繡元素，呼應原始場景（簡單的繡花造型，不含可辨讀文字），並保持在主體之下的次要地位。全程保留人物可辨識的姿勢與五官。不要生成：平滑的攝影質感、平面向量上色、3D渲染、繪畫式筆觸，或人物可辨識身份的喪失。"
  },
  {
    "id": "4ab44563-0521-47e7-a9a5-d94d71c64277",
    "title": "Layered Papercut Diorama",
    "prompt": "Transform the person in the photo into a fantasy layered papercut diorama, a handcrafted 3D paper-art scene, keeping their pose, silhouette, and identity recognizable. Render the figure and surrounding scene as an ultra-detailed papercut illustration in soft pastel tones, with felt and cardstock textures and stacked paper layers that show visible depth. Give the person a thick white silhouette outline, like a cut-paper sticker layer, separating them from the scene behind. Build a cozy, storybook travel scene around them: decorative paper flowers, cute accessories, a blue sky background with fluffy paper clouds, and a charming miniature-town backdrop. Light it with soft daylight, a warm ambient glow, gentle shadows, and pastel highlights for a dreamy, nostalgic mood. Keep the paper texture tactile and highly detailed, like a professional papercraft diorama or a children's storybook illustration. Preserve the person's recognizable pose, silhouette, and identity throughout. Do not generate: flat vector illustration, smooth digital rendering, photorealistic skin texture, 3D CGI rendering, or loss of the person's recognizable identity.",
    "identityMode": "reinforced",
    "categoryId": "6ad0a676-4347-4eb6-9db1-7b3938f373ae",
    "imageFile": "6830735d-114a-4d83-b25e-c2d6ce7fc9f9.jpg",
    "enabled": true,
    "order": 9,
    "createdAt": "2026-07-27T06:51:27.035Z",
    "updatedAt": "2026-07-31T03:27:29.542Z",
    "titleZh": "分層剪紙立體模型",
    "promptZh": "將照片中的人物轉變為奇幻分層剪紙立體模型，一個手工製作的3D紙藝場景，保留其姿勢、輪廓與身份可辨識度。將人物與周圍場景以極致細緻的剪紙插畫呈現，色調柔和粉彩，帶有毛氈與卡紙質感，並以堆疊的紙層呈現可見的深度。為人物加上厚實的白色剪影外框，如同一層剪紙貼紙，將其與背景場景區隔開來。在其周圍打造溫馨的繪本旅行場景：裝飾性紙花、可愛配件、藍天背景搭配蓬鬆的紙製雲朵，以及迷人的微型城鎮背景。以柔和日光、溫暖的環境光暈、輕柔陰影與粉彩高光打光，營造夢幻懷舊的氛圍。保持紙張質感觸感豐富且細節精緻，如同專業紙藝立體模型或童書插畫。全程保留人物可辨識的姿勢、輪廓與身份。不要生成：平面向量插畫、平滑的數位渲染、寫實皮膚質感、3D電腦動畫渲染，或人物可辨識身份的喪失。"
  },
  {
    "id": "d10158e6-3920-41ae-a2f8-e924e18ff515",
    "title": "Mini 3D Doll Scrapbook",
    "prompt": "Convert this photo into a cozy scrapbook-style edit, strictly preserving the original subject's identity, pose, lighting, and background exactly as they are, do not redraw or move the person. Add several miniature 3D doll versions of the same person (matching their look and outfit) scattered around the scene, each doing a different small activity, such as reading a book, taking a photo, or waving. Render these mini dolls in a cute, glossy 3D toy style with soft rounded proportions. Overlay playful hand-drawn doodles throughout the empty areas of the frame: arrows, hearts, stars, sparkles, and short fun handwritten text. Use a pastel color palette, a white background with pink, peach, and blue accents. Keep the overall composition full and balanced, filling empty space without covering the main subject's face. The result should feel like a light aesthetic touch-up and set of cute annotations added on top of the original photo, not a full redraw of the photo itself. Preserve the original subject's recognizable identity, pose, and photo realism throughout.",
    "identityMode": "reinforced",
    "categoryId": "4ed760a1-09f7-4274-aa0d-83a30ca389db",
    "imageFile": "7ed0b170-75ef-4709-9abb-ddb844a28135.jpg",
    "enabled": true,
    "order": 8,
    "createdAt": "2026-07-27T06:52:34.236Z",
    "updatedAt": "2026-07-31T03:27:29.546Z",
    "titleZh": "迷你3D玩偶手帳",
    "promptZh": "將這張照片轉換為溫馨的手帳風編輯效果，嚴格保留原始主體的身份、姿勢、光線與背景，完全不變，不得重新繪製或移動人物。在畫面周圍加入數個與人物造型、服裝相符的迷你3D玩偶版本，各自進行不同的小動作，例如閱讀、拍照或揮手。以可愛光澤的3D玩具風格呈現這些迷你玩偶，比例柔和圓潤。在畫面空白處疊加俏皮的手繪塗鴉：箭頭、愛心、星星、閃光與簡短有趣的手寫文字。使用粉彩色調，白色背景搭配粉紅、桃色與藍色點綴。保持整體構圖飽滿平衡，填滿空白處但不遮擋主體臉部。成品應呈現如同對原照片進行輕微的美學修飾與可愛標註，而非完全重新繪製。全程保留原始主體可辨識的身份、姿勢與照片寫實感。"
  },
  {
    "id": "05642a60-3958-471c-b6a7-83c821ff1845",
    "title": "Dopamine Illustration",
    "prompt": "Transform the person in the photo into a trendy creative vector illustration, built from flowing curves and clean, minimal linework, with soft, soothing flat color blocks in a fresh, minimalist design style. Use a lively, eye-catching 'dopamine' color palette, bright and saturated but soft-toned hues. Remove all realistic textures, skin detail, and fine surface detail, rendering the person with fluid, dynamic vector linework only. Decorate the scene with loosely arranged, irregular rounded color-block shapes for a naturally soft, artistic texture. Keep the overall style fresh, modern, and full of creative energy. Use a plain solid white background so the main subject stands out clearly. Preserve the person's recognizable pose, silhouette, and general likeness, simplified into this clean vector style but still identifiable as them. Do not generate: photorealistic skin or texture, halftone dots, hand-drawn sketchy or jittery linework, 3D rendering, or complex detailed backgrounds.",
    "identityMode": "reinforced",
    "categoryId": "89d3d50f-6ef4-437c-95c0-c799f8fb6440",
    "imageFile": "23e7a817-57e7-4a4e-9859-fd70a6a61034.jpg",
    "enabled": true,
    "order": 7,
    "createdAt": "2026-07-27T06:53:35.701Z",
    "updatedAt": "2026-07-31T03:27:29.549Z",
    "titleZh": "多巴胺插畫",
    "promptZh": "將照片中的人物轉換為潮流創意向量插畫，以流暢曲線與簡潔俐落的線條構成，搭配柔和舒緩的平塗色塊，呈現清新極簡的設計風格。使用活潑亮眼的「多巴胺」色調，明亮飽和卻柔和的色彩。去除所有寫實質感、皮膚細節與表面細節，僅以流動、靈動的向量線條呈現人物。以隨性排列、不規則的圓潤色塊裝飾畫面，營造自然柔和的藝術質感。保持整體風格清新、現代，充滿創意能量。使用純白色純色背景，讓主體清楚突出。保留人物可辨識的姿勢、輪廓與大致樣貌，簡化為這種簡潔的向量風格，但仍可辨識為本人。不要生成：寫實皮膚或質感、網點、手繪潦草或顫抖的線條、3D渲染，或複雜精細的背景。"
  },
  {
    "id": "65805ea2-967d-4c5a-8ce2-bef6659df9ae",
    "title": "Chibi Travel Poster",
    "prompt": "Transform the person in the photo into a cute chibi-style miniature traveler character, placed into a travel-vlogger poster design exploring a famous world city, infer a scenic city setting that matches the photo's mood if none is obvious. Render huge, bold 3D lettering spelling out the city name, filled inside with landmark photography and cityscape views, with the cute chibi version of the person sitting around or walking between the letters. Use a cinematic travel-collage aesthetic, like a glossy travel-magazine cover, with a bright blue sky background and a lively vacation mood, in a collectible postcard style. Render the chibi character with ultra-detailed, soft-lit, playful cute-anime styling, blending realistic landmark photography with the stylized character. Add travel stamps, a passport mark, handwritten travel notes, and brush lettering reading 'TRAVELLOG'. Use a clean, modern graphic poster layout, colorful editorial design, high resolution, and a vertical composition, like a polished commercial travel poster. Give the chibi character a small backpack, camera, map, and luggage, with cute, slightly exaggerated proportions. Keep the person's face and overall look recognizable even in this simplified chibi form. Do not generate: photorealistic full-body rendering of the person, a flat single-color background, or loss of the person's recognizable identity.",
    "identityMode": "reinforced",
    "categoryId": "6ad0a676-4347-4eb6-9db1-7b3938f373ae",
    "imageFile": "fdb77625-2d72-4b9e-bc72-4617e4767a97.jpg",
    "enabled": true,
    "order": 6,
    "createdAt": "2026-07-27T06:54:43.032Z",
    "updatedAt": "2026-07-31T03:27:29.552Z",
    "titleZh": "Q版旅行海報",
    "promptZh": "將照片中的人物轉變為可愛Q版迷你旅行者角色，置入探索世界知名城市的旅行部落客海報設計中；若照片氛圍無明顯提示，可自行推斷合適的城市場景。呈現巨大粗體的3D城市名稱字體，內部填滿地標攝影與城市風景，可愛的Q版人物坐在或走在字母之間。運用電影感的旅行拼貼美學，如同光澤旅遊雜誌封面，搭配明亮藍天背景與生動的度假氛圍，呈現收藏明信片般的風格。以極致細緻、柔和光線、俏皮可愛動漫風格呈現Q版角色，將寫實地標攝影與風格化角色自然融合。加入旅行郵戳、護照章、手寫旅行筆記，以及寫著「TRAVELLOG」的畫筆字體。使用乾淨現代的圖形海報版面、色彩繽紛的編輯設計、高解析度與直式構圖，如同精緻的商業旅遊海報。為Q版角色加上小背包、相機、地圖與行李箱，比例可愛且略微誇張。即使在這種簡化的Q版造型中，也須保持人物臉部與整體樣貌可辨識。不要生成：人物的完全寫實全身渲染、純色平面背景，或人物可辨識身份的喪失。"
  },
  {
    "id": "c134b04f-15e3-4b0b-879f-30181245dcc1",
    "title": "Pen Sketch Notebook",
    "prompt": "Transform the person in the photo into a bold pen-sketch illustration, using this photo as the reference. Outline the figure with confident, flowing strokes in bold red and warm yellow ink, keeping visible sketch marks and cross-hatched shading throughout. Set the figure against notebook-style paper with soft ruled lines as the background, surrounded by doodle-style decorations: hearts, arrows, stars, and handwritten lettering. Keep the overall style modern and pop-art-influenced, with an editorial sketchbook aesthetic, fashionable and expressive, rich in detail, blending flat graphic elements with realistic hand-drawn touches. Fill the frame completely, no black or empty/blank areas should appear anywhere in the image. Preserve the person's recognizable pose, facial features, and identity throughout. Do not generate: photorealistic skin texture, a plain empty background, or loss of the person's recognizable identity.",
    "identityMode": "reinforced",
    "categoryId": "4ed760a1-09f7-4274-aa0d-83a30ca389db",
    "imageFile": "d21e3084-9df7-4f7f-8e66-d14f3c12ddbd.jpg",
    "enabled": true,
    "order": 5,
    "createdAt": "2026-07-27T06:55:16.644Z",
    "updatedAt": "2026-07-31T03:27:29.556Z",
    "titleZh": "鋼筆素描筆記本",
    "promptZh": "將照片中的人物轉換為大膽的鋼筆素描插畫，以此照片為參考依據。以自信流暢的筆觸，用醒目的紅色與暖黃色墨水勾勒人物輪廓，全程保留明顯的素描痕跡與交叉排線陰影。將人物置於帶有柔和格線的筆記本風格紙張背景前，周圍環繞塗鴉風格的裝飾：愛心、箭頭、星星與手寫字體。保持整體風格現代並帶有普普藝術影響，呈現編輯感十足的素描本美學，時尚且富有表現力，細節豐富，融合平面圖形元素與寫實手繪筆觸。畫面須完整填滿，不得出現任何黑色或空白區域。全程保留人物可辨識的姿勢、五官與身份。不要生成：寫實皮膚質感、純色空白背景，或人物可辨識身份的喪失。"
  },
  {
    "id": "04ad77e4-cddf-4ebc-b2a4-4a8d05425ade",
    "title": "Rounded Chibi Sticker",
    "prompt": "Transform the person in the photo into a die-cut vinyl sticker-style brand-mascot illustration, based on this photo as reference. Use minimalist line art with flat coloring, soft and cute chibi proportions, giving the figure a rounded, soothing character quality. Render it in a two-color flat palette: pure white fill for the main body, with an even-weight blue outline. Add a white sticker border expanding outward around the whole figure, with high contrast, no gradients, and no extra colors, kept clean and crisp. Give it a vector-illustration quality: evenly-weighted rounded outlines, flat single-color fill, no shading or texture, and smooth lines with no sharp corners. Simplify the figure into clean geometric chibi forms while keeping it recognizable as the person. Simulate the texture of a die-cut vinyl sticker, high-resolution vector quality, no noise or stray colors, with a fully consistent style throughout the image. Preserve the person's recognizable pose, hairstyle silhouette, and general likeness in this simplified chibi form. Do not generate: photorealistic texture, multiple colors beyond white and blue, gradients, shading, or loss of the person's recognizable identity.",
    "identityMode": "reinforced",
    "categoryId": "89d3d50f-6ef4-437c-95c0-c799f8fb6440",
    "imageFile": "502320a5-b4fa-414a-9a0c-2bfc92e1509a.jpg",
    "enabled": true,
    "order": 4,
    "createdAt": "2026-07-27T06:56:29.331Z",
    "updatedAt": "2026-07-31T03:27:29.559Z",
    "titleZh": "圓潤Q版貼紙",
    "promptZh": "將照片中的人物轉變為模切乙烯貼紙風格的品牌吉祥物插畫，以此照片為參考依據。使用極簡線條搭配平塗上色，柔和可愛的Q版比例，賦予人物圓潤療癒的角色特質。以雙色平塗色盤呈現：主體填滿純白色，搭配等粗的藍色輪廓線。在整個人物外圍加上白色貼紙邊框，呈現高對比、無漸層、無多餘色彩的乾淨俐落效果。賦予其向量插畫的質感：等粗的圓潤輪廓線、單色平塗、無陰影或紋理，線條平滑無尖角。將人物簡化為乾淨的幾何Q版造型，同時保持可辨識為本人。模擬模切乙烯貼紙的質感，呈現高解析度向量品質，無噪點或雜色，全畫面風格高度一致。全程保留人物可辨識的姿勢、髮型輪廓與大致樣貌，呈現於這種簡化的Q版造型中。不要生成：寫實質感、白色與藍色以外的多種色彩、漸層、陰影，或人物可辨識身份的喪失。"
  },
  {
    "id": "22f79227-46ca-4c87-afb4-6bb6a679bc3b",
    "title": "Fridge Magnet Icon",
    "prompt": "Extract the most recognizable main subject from the photo and turn it into a realistic fridge-magnet-style icon combine with japan manga style. Keep the subject's core silhouette and signature features, with an overall clean, minimal design, giving it the look of a travel-souvenir fridge magnet. Give it a slight three-dimensional, raised feel with a soft drop shadow beneath it, clear-edged outlines paired with a light or white border stroke around the whole shape. Simplify details moderately without overworking them, keep the icon small, neat, and refined, and leave generous white space around it on a plain background. Preserve the recognizable identity, pose, and key features of the original subject throughout. Do not generate: a fully flat 2D sticker with no depth, a cluttered or busy background, or loss of the subject's recognizable identity.",
    "identityMode": "reinforced",
    "categoryId": "38d3befa-39e5-47d4-bf0b-a140792b2ac3",
    "imageFile": "670e52a3-7860-4a0f-8d16-eb038b714d04.jpg",
    "enabled": true,
    "order": 3,
    "createdAt": "2026-07-27T06:57:30.351Z",
    "updatedAt": "2026-07-31T03:27:29.562Z",
    "titleZh": "冰箱貼圖標",
    "promptZh": "提取照片中辨識度最高的主體元素，將其轉化為結合日式漫畫風格的寫實冰箱貼圖標。保留主體核心輪廓與標誌性特徵，整體造型簡潔乾淨，呈現旅行紀念品冰箱貼的視覺效果。賦予其輕微的立體浮凸感，搭配柔和的投影，輪廓邊緣清晰並搭配淺色或白色描邊。適度簡化細節，不做過度繁複的刻畫，讓圖標保持小巧精緻，並在純色背景周圍留有大量留白。全程保留原始主體可辨識的身份、姿勢與關鍵特徵。不要生成：完全平面無立體感的2D貼紙、雜亂繁忙的背景，或主體可辨識身份的喪失。"
  },
  {
    "id": "2291b1a2-9557-4c80-a7c7-ef769e90aa31",
    "title": "Architectural Blueprint Poster",
    "prompt": "Based on the uploaded photo of a building, create a flat, vector-style architectural illustration with the aesthetic of a data infographic. Precisely reproduce the building's overall silhouette, proportions, roof style, facade layering, and window/door layout. Remove all extraneous elements from the scene, sky, pedestrians, street greenery, and other clutter. Use pure white and light neutral tones as the base, with the building's front facade centered in the frame, following the symmetrical design logic of an architectural blueprint. Outline the form with crisp dark linework, filled with flat, even color blocks, accented with subtle light-and-shadow shading and delicate highlights, for a clean, premium, professional architectural-drafting look. Add a fitting style name in English in the upper-left corner, and layer large, semi-transparent light-gray text behind the building as an atmospheric background texture. Add dimension-marking lines appropriate to the building's scale: height values labeled along the side of tall buildings, and length/width data labeled at the base of elongated buildings, using an approximate-value marker for any unknown measurements. Add simple scale-ruler ticks to the image. Along the side, label the building's name, location, and construction date in vertical red text. Overall, the layout should suit an architecture-education poster or a professional surveying/drafting format, with neat, clean linework, a unified, understated, elegant color palette, and comfortable, premium white space.",
    "identityMode": "none",
    "categoryId": null,
    "imageFile": "7a1ad157-f76e-4293-9dfa-d3a124640cb0.jpg",
    "enabled": true,
    "order": 2,
    "createdAt": "2026-07-27T06:58:13.068Z",
    "updatedAt": "2026-07-31T03:27:29.566Z",
    "titleZh": "建築藍圖海報",
    "promptZh": "依據上傳的建築照片，創作一幅兼具數據資訊圖表美感的扁平化向量建築插畫。精準複製建築的整體輪廓、比例、屋頂樣式、立面層次與門窗布局。清除畫面中所有多餘元素，如天空、路人、街道綠植與其他雜物。使用純白與淺中性色作為基底，建築正立面居中呈現，遵循建築藍圖的對稱設計邏輯。以俐落的深色線條勾勒外形，搭配平整均勻的色塊填充，並點綴細膩的明暗陰影與精緻高光，營造簡約高級、專業建築製圖的觀感。在左上角加入合適的英文風格名稱，並在建築後方疊加大型半透明淺灰色文字作為氛圍感底紋。依照建築規格加入合適的尺寸標註線條：高樓側邊標註高度數值，長形建築底部標註長寬數據，未知數值統一以約略標識標註。在畫面中加入簡約的比例刻度。側邊以直排紅色文字標註建築名稱、所在地與建造年份。整體版面應適合建築科普海報或專業測繪版式，線條工整乾淨，色調統一素雅，並保留舒適高級的留白。"
  },
  {
    "id": "de15a6d7-04a8-4268-ba3f-1fd5a0502d0f",
    "title": "Miniature Postage Stamp",
    "prompt": "Transform the main landmark or subject in the photo into an ultra-detailed 3D miniature travel postage-stamp diorama. Have the landmark emerge in relief from a realistic postage stamp, floating against a vibrant orange studio background, viewed from an isometric perspective, with tiny figures walking around the scene. Add fluffy floating clouds casting soft shadows, cinematic lighting, photorealistic architecture, intricate city detail, and crystal-clear water reflections where relevant. Give it a luxury travel-ad quality, like a collectible miniature world, with a tilt-shift photography look and hyperrealistic textures, in a premium travel-poster design with a travel-postcard aesthetic. Integrate clean lettering into the stamp's border, with a fitting destination name in bold modern type and a short tagline beneath it. Emphasize a sense of depth-and-scale illusion, evoking a spirit of global exploration. Render it with award-winning 3D quality: global illumination, ray tracing, ultra-sharp focus, vivid colors, and 8K masterpiece detail. Preserve the recognizable identity of the main subject or landmark from the photo.",
    "identityMode": "none",
    "categoryId": "38d3befa-39e5-47d4-bf0b-a140792b2ac3",
    "imageFile": "6917bf91-3fbf-467a-a9e7-01963d0f8af3.jpg",
    "enabled": true,
    "order": 1,
    "createdAt": "2026-07-27T06:59:23.597Z",
    "updatedAt": "2026-07-31T03:27:29.570Z",
    "titleZh": "微縮郵票",
    "promptZh": "將照片中的主要地標或主體轉變為超精緻的3D微縮旅行郵票立體模型。讓地標從逼真的郵票中浮凸而出，漂浮於充滿活力的橙色棚拍背景上，以等角透視呈現，畫面周圍有微小人物行走。加入蓬鬆漂浮的雲朵投下柔和陰影、電影感燈光、寫實建築細節、繁複的城市細節，以及在適當情況下呈現清澈如晶的水面倒影。賦予其奢華旅遊廣告般的質感，宛如可收藏的微縮世界，帶有移軸攝影效果與超寫實質感，呈現高級旅遊海報設計與明信片美學。將簡潔的字體融入郵票邊框，搭配合適的目的地名稱以粗體現代字型呈現，下方附有簡短標語。強調深度與比例的錯覺感，喚起探索世界的精神。以獲獎級3D品質渲染：全局光照、光線追蹤、超銳利對焦、鮮豔色彩，以及8K傑作等級的細節。保留照片中主要主體或地標的可辨識身份。"
  },
  {
    "id": "2e9178c0-028a-4b03-9cdf-94c521299cb4",
    "title": "Funko Pop Figure",
    "prompt": "Transform the person into a Funko Pop-style vinyl collectible figure, keeping their pose, hairstyle silhouette, clothing colors, and overall identity recognizable. Give the figure the characteristic oversized, slightly flattened head with simple black dot eyes and no nose or mouth detail, a small stylized body with simplified proportions, and a smooth, glossy vinyl toy material. Keep clothing and hair rendered as smooth vinyl shapes matching the original outfit's colors and silhouette. Place the figure standing on a small round plastic base. Display it inside clear plastic blister packaging on a printed cardboard backing card, with soft gradient background art, small printed text blocks and logo-style graphics (illegible or generic, not real text), styled like an authentic collectible figure box. Light it like a product photo, soft studio lighting with a subtle shadow beneath the packaging. Do not generate: a realistic human face, detailed facial features beyond simple dot eyes, a fully photographic figure, or loss of the person's recognizable identity through hairstyle, outfit, and silhouette.",
    "identityMode": "reinforced",
    "categoryId": "38d3befa-39e5-47d4-bf0b-a140792b2ac3",
    "imageFile": "0a7e7a46-7530-4ee8-89c9-9a7155555d8f.jpg",
    "enabled": true,
    "order": 0,
    "createdAt": "2026-07-27T07:04:28.698Z",
    "updatedAt": "2026-07-31T03:29:09.030Z",
    "titleZh": "Funko Pop 公仔",
    "promptZh": "將人物轉變為Funko Pop風格的乙烯基收藏公仔，保留其姿勢、髮型輪廓、服裝顏色與整體身份可辨識度。賦予公仔標誌性的特大扁平頭部，搭配簡單的黑色圓點眼睛，不含鼻子或嘴巴細節，小巧風格化的身軀比例簡化，並呈現光滑光澤的乙烯玩具材質。服裝與頭髮應呈現平滑的乙烯造型，與原始服裝的顏色及輪廓相符。讓公仔站立於小型圓形塑膠底座上。展示於透明塑膠吸塑包裝中，搭配印刷紙板底卡，帶有柔和漸層背景圖案、小型印刷文字區塊與標誌風格圖形（模糊或通用，非真實文字），造型如同正版收藏公仔盒裝。以商品攝影般的方式打光，柔和棚燈搭配包裝下方的細膩陰影。不要生成：寫實的人臉、超出簡單點狀眼睛的精細五官細節、完全照片寫實的公仔，或透過髮型、服裝與輪廓造成的人物可辨識身份喪失。"
  },
  {
    "id": "c1ed50b2-b380-44e4-be21-0ca53371319a",
    "title": "Google Maps Pin Character",
    "prompt": "Transform the person into a small, cute 3D character figure standing on top of a stylized map, as if they were the character brought to life from a map pin marker. Keep their pose, hairstyle silhouette, clothing colors, and overall identity recognizable, rendered in a smooth, glossy 3D toy style with soft rounded proportions. Place the figure standing at the tip of a classic teardrop-shaped map pin marker, in a bold, saturated color (red or blue), with the character emerging from or standing just above the pin's circular top. Set this on a simplified, stylized map background below, with flat-colored roads, blocks, and a few small landmark icons, similar to a clean digital map app interface. Light the scene like a clean 3D render with soft shadows beneath the pin. Keep the overall look playful, polished, and miniature. Preserve the person's recognizable identity, pose, and outfit throughout. Do not generate: a realistic photographic figure, a cluttered or overly detailed map background, or loss of the person's recognizable identity.",
    "identityMode": "reinforced",
    "categoryId": "38d3befa-39e5-47d4-bf0b-a140792b2ac3",
    "imageFile": "fa8a3649-05be-43e7-956e-c2064130a2ad.jpg",
    "enabled": true,
    "order": -1,
    "createdAt": "2026-07-27T07:04:28.709Z",
    "updatedAt": "2026-07-31T03:29:09.039Z",
    "titleZh": "地圖定位人偶",
    "promptZh": "將人物轉變為站立於風格化地圖上方的小巧可愛3D角色公仔，彷彿是從地圖定位標記中活化而來的角色。保留其姿勢、髮型輪廓、服裝顏色與整體身份可辨識度，以光滑光澤的3D玩具風格呈現，比例柔和圓潤。讓公仔站立於經典水滴形地圖定位標記的頂端，標記呈現大膽飽和的顏色（紅色或藍色），角色從標記的圓形頂部探出或站立其上。下方搭配簡化的風格化地圖背景，帶有平面色塊道路、街區與幾個小型地標圖示，類似乾淨的數位地圖應用程式介面。以乾淨的3D渲染方式為場景打光，定位標記下方帶有柔和陰影。保持整體造型俏皮、精緻且具微縮感。全程保留人物可辨識的身份、姿勢與服裝。不要生成：完全照片寫實的公仔、雜亂或過於精細的地圖背景，或人物可辨識身份的喪失。"
  },
  {
    "id": "e357d177-3c0a-4d2f-9638-4bd0d6462086",
    "title": "Cross-Stitch Pattern",
    "prompt": "Convert the photo into a cross-stitch embroidery pattern, preserving the person's pose, facial features, hairstyle, and clothing silhouette so they remain clearly recognizable. Render the entire image as a grid of small, uniform X-shaped stitches, each a single flat color, visible individually like a charted needlepoint pattern stitched onto even-weave fabric. Use a limited, blocky color palette with hard-edged transitions between colors rather than smooth gradients, since each stitch can only hold one color. Keep the aida-cloth fabric texture visible in the background and between stitches, with a slightly frayed or looped thread texture on close inspection. Keep the overall image charmingly pixelated and handcrafted-looking, like a real finished cross-stitch piece in an embroidery hoop or frame. Preserve the person's recognizable identity, pose, and features throughout, simplified into the stitch grid. Do not generate: smooth photographic gradients, painterly shading, a fully solid-fill embroidered patch with no visible stitch grid, or loss of the person's recognizable identity.",
    "identityMode": "reinforced",
    "categoryId": "6ad0a676-4347-4eb6-9db1-7b3938f373ae",
    "imageFile": "9be3a5d3-ce35-404a-be7c-ee71822e893e.jpg",
    "enabled": true,
    "order": -4,
    "createdAt": "2026-07-27T07:04:28.720Z",
    "updatedAt": "2026-07-31T03:29:09.042Z",
    "titleZh": "十字繡圖案",
    "promptZh": "將照片轉換為十字繡刺繡圖案，保留人物的姿勢、五官、髮型與服裝輪廓，使其保持清晰可辨識。將整張圖呈現為由小巧均勻的X形繡點構成的網格，每個繡點皆為單一平面色彩，個別清晰可見，如同繡在平織布料上的圖表化針織圖案。使用有限的塊狀色盤，色彩之間呈現硬邊過渡而非平滑漸層，因為每個繡點僅能呈現一種顏色。保持背景與繡點之間可見的亞麻布質感，近看時帶有些微磨損或環狀的線材質感。保持整體畫面呈現迷人的像素化手工感，如同真正完成的十字繡作品，裝裱於繡框或相框中。全程保留人物可辨識的身份、姿勢與五官，並簡化為此繡點網格。不要生成：平滑的攝影漸層、繪畫式陰影、完全實色填滿且無可見繡點網格的刺繡貼布，或人物可辨識身份的喪失。"
  },
  {
    "id": "21aef128-6cb9-482d-bc3d-75f387c665c2",
    "title": "Coin Relief Medallion",
    "prompt": "Reimagine the person as a profile portrait minted into a classical coin or medallion, preserving their facial structure, hairstyle silhouette, and expression so they remain recognizable, adapted into a dignified side-profile bust pose typical of minted coinage. Render the entire image as a single uniform metal material, aged bronze, silver, or gold, with a raised relief surface: the portrait should appear physically embossed and three-dimensional, catching light along raised edges with darker recessed shadows in the grooves. Remove all color from skin, hair, and clothing, unifying everything into the metal's tone and patina. Add a circular coin border around the portrait, with a decorative rim design, and leave space for small ornamental engraved flourishes or laurel-leaf motifs along the edge. Light it dramatically from one side to emphasize the embossed relief texture. Preserve the person's recognizable facial profile and hairstyle silhouette throughout. Do not generate: full color, a frontal non-profile pose, photographic skin texture, or loss of the person's recognizable identity.",
    "identityMode": "reinforced",
    "categoryId": "38d3befa-39e5-47d4-bf0b-a140792b2ac3",
    "imageFile": "d6e8b041-c56c-4ee0-ac01-9bd85a02e1e5.jpg",
    "enabled": true,
    "order": -5,
    "createdAt": "2026-07-27T07:04:28.723Z",
    "updatedAt": "2026-07-31T03:29:09.046Z",
    "titleZh": "硬幣浮雕紀念章",
    "promptZh": "將人物重新構想為鑄印於古典硬幣或紀念章上的側面肖像，保留其臉部結構、髮型輪廓與表情，使其保持可辨識，並轉化為鑄幣常見的莊重側面半身姿態。將整張圖呈現為單一均勻的金屬材質——做舊青銅、銀色或金色——表面呈現浮雕凸起：肖像應呈現實體浮凸的立體感，凸起邊緣捕捉光線，凹槽處則呈現較深的陰影。去除皮膚、頭髮與服裝的所有色彩，將一切統一於金屬的色調與銅鏽之中。在肖像周圍加上圓形硬幣邊框，帶有裝飾性的邊緣設計，並在邊緣留白處加入小型裝飾性雕刻花紋或月桂葉圖案。以戲劇性的側光打光，強調浮雕凸起的質感。全程保留人物可辨識的臉部側面輪廓與髮型輪廓。不要生成：全彩、非側面的正面姿勢、照片寫實的皮膚質感，或人物可辨識身份的喪失。"
  },
  {
    "id": "625b916b-f4f0-4a33-b7c0-84d67b49e6cd",
    "title": "Tarot Card Portrait",
    "prompt": "Transform the person into an illustrated tarot card portrait, preserving their pose, facial features, hairstyle, and clothing silhouette so they remain clearly recognizable, styled as the central figure of an ornate mystical tarot card. Render the figure in a detailed, symbolic illustration style with rich jewel-toned colors, dramatic linework, and mystical symbolism woven into the composition: stars, celestial motifs, flowing drapery, and meaningful objects placed around the figure. Surround the entire image with a decorative ornate border typical of tarot cards, with symmetrical flourishes, small symbolic icons, and a fitting card title in an elegant serif or gothic-style font at the top or bottom (invent a fitting evocative title, do not use real tarot card names). Keep the lighting dramatic and atmospheric, with a sense of depth and mystery. Preserve the person's recognizable identity, pose, and expression throughout, elevated into this symbolic illustrated style. Do not generate: photorealistic texture, a plain undecorated background with no border, or loss of the person's recognizable identity.",
    "identityMode": "reinforced",
    "categoryId": "d7f9ac70-0439-42da-b4c2-10a929998ad8",
    "imageFile": "56b384de-11e3-490d-a051-b6675b481942.jpg",
    "enabled": true,
    "order": -6,
    "createdAt": "2026-07-27T07:04:28.726Z",
    "updatedAt": "2026-07-31T03:29:09.049Z",
    "titleZh": "塔羅牌肖像",
    "promptZh": "將人物轉變為插畫風格的塔羅牌肖像，保留其姿勢、五官、髮型與服裝輪廓，使其保持清晰可辨識，並將其塑造為華麗神秘塔羅牌中的核心人物。以精緻具象徵意涵的插畫風格呈現人物，運用濃郁的寶石色調、戲劇性的線條，並在構圖中融入神秘象徵元素：星星、天體圖騰、飄逸的布料，以及圍繞人物擺放的寓意物件。在整張圖周圍加上塔羅牌常見的華麗裝飾邊框，帶有對稱花紋、小型象徵圖示，以及在頂部或底部以優雅襯線體或哥德風字體呈現合適的卡牌標題（請自創一個貼切且富有意境的標題，不使用真實塔羅牌名稱）。保持光線戲劇化且氛圍濃厚，帶有深邃與神秘感。全程保留人物可辨識的身份、姿勢與表情，並將其提升至這種象徵性插畫風格。不要生成：寫實質感、無邊框的純色空白背景，或人物可辨識身份的喪失。"
  },
  {
    "id": "2e327abb-0fa1-4332-ad3d-3676f0ca28cf",
    "title": "Cinematic Product Poster",
    "prompt": "Using the uploaded photo as the shape reference, create a surreal, cinematic fantasy forest scene: build a giant natural archway out of towering moss-covered trees and rock walls, densely wrapped in damp vines and vivid green moss, where the overall silhouette of the archway follows the exact outline and curves of the product or subject in the uploaded photo, its contour becomes the shape of the arch, and its natural opening becomes the archway's opening at the top. Layer the inner walls of the archway with lush, richly textured stacked greenery. Through the opening of the archway, reveal a distant forest valley shrouded in soft, veil-like white mist, with faint mountains visible in soft light beyond. Light the scene with soft natural backlight streaming through from behind the archway, hazy and warm-toned, creating delicate light-and-shadow layering across the greenery that forms the silhouette, for an ethereal, serene atmosphere. Place a small black silhouetted figure on a winding stone path beneath the archway to emphasize the grand scale of the scene. Look closely at what the subject in the uploaded photo actually is, then invent a fitting brand-style title based specifically on that subject (its type, color, and character), not a generic or unrelated name, and never a real trademarked brand. Overlay this title in the center of the archway in an elegant serif font, with a smaller tagline beneath it that also fits the actual subject, blended naturally into the archway. Use a color palette of deep and vivid forest greens, paired with pale white mist and warm-toned light glow. Keep the overall style cinematic, fantastical, and natural, blended with polished commercial brand visual quality, rich in fine detail and layered depth.",
    "identityMode": "none",
    "categoryId": "f871e8e7-6bc6-42f6-b020-80d083a50e01",
    "imageFile": "7fe646fe-8133-45b3-b4f5-bc6fbc312f67.jpg",
    "enabled": true,
    "order": -7,
    "createdAt": "2026-07-31T02:18:30.925Z",
    "updatedAt": "2026-07-31T03:29:09.053Z",
    "titleZh": "電影感產品海報",
    "promptZh": "以上傳的照片作為形狀參考，創作一幅超現實電影感的奇幻森林場景：以覆蓋苔蘚的參天巨樹與岩壁打造一座巨型天然拱門，纏繞著濕潤藤蔓與鮮綠苔蘚，拱門的整體輪廓依循上傳照片中產品或主體的精確外形與曲線，其輪廓成為拱門的形狀，其自然開口則成為拱門頂端的開口。以豐富細緻的堆疊綠植層層鋪陳拱門內壁。透過拱門的開口，可見遠方被薄紗般白霧籠罩的森林山谷，柔和光線下若隱若現的山巒。以柔和的自然逆光從拱門後方透入場景，朦朧且帶暖調光暈，在構成輪廓的綠植表面形成細膩的明暗層次，營造空靈靜謐的氛圍。在拱門下方蜿蜒的石徑上放置一個渺小的黑色剪影人物，以襯托場景的宏大規模。仔細觀察上傳照片中的主體究竟是什麼，然後根據該主體（其類型、顏色與特質）發想一個貼切的品牌風格標題，不使用通用或無關的名稱，也絕不使用真實商標品牌。將此標題以優雅襯線字體疊加於拱門中央，下方搭配同樣貼合實際主體的較小標語，自然融入拱門之中。使用深邃鮮豔的森林綠色調，搭配淺白霧氣與暖調光暈。保持整體風格電影感、奇幻且自然，融合精緻的商業品牌視覺質感，細節豐富且層次分明。"
  },
  {
    "id": "90782525-1f08-437d-993b-098955ce77cd",
    "title": "Puffy Inflated Poster",
    "prompt": "Create a bold event-poster design with a high-saturation bright lime-green inflated plastic packaging texture throughout: the background is a puffed-up, wrinkled bright green plastic material with a slight glossy sheen and raised, bulging surface texture, like an inflated plastic package. Render all text and graphic elements with the same puffy, inflated 3D look: thick, rounded, bulging letterforms that look like they're filled with air, with soft highlights and shadows following the rounded surface. Look closely at what the main subject in the uploaded photo actually is, then invent a fitting title and short tagline based specifically on that subject, for example, if it's a drink, name it in a way that fits its real appearance, color, and likely flavor; if it's another kind of object, base the title and tagline on what it visibly is, not a generic or unrelated name. Give the title text a bold puffy white treatment, with its edges blending slightly into the green background, paired with a secondary line of puffy black text for the subtitle, both written to match the uploaded photo's actual subject. In the center of the composition, place the product or subject from the uploaded photo, rendered in the same inflated, puffy, glossy bright-green material as the background, as if it were made of the same puffed plastic, positioned at a slight tilt as if embedded into the background. Add a short puffy white slogan or tagline beside the main subject in the same inflated 3D lettering style, written to specifically suit the subject shown in the photo. Add a line of smaller puffy white supporting text near the bottom that fits the subject's theme, not real business names, locations, or addresses. Keep the overall style bold, playful, retro-street, and slightly quirky, with every element sharing the same puffed, inflated, air-filled look. Restrict the color palette to just high-saturation bright green, white, and black, with a fully unified material texture throughout.",
    "identityMode": "none",
    "categoryId": "f871e8e7-6bc6-42f6-b020-80d083a50e01",
    "imageFile": "dd420607-c5cc-48db-8461-e4353abc2520.jpg",
    "enabled": true,
    "order": -8,
    "createdAt": "2026-07-31T02:20:15.524Z",
    "updatedAt": "2026-07-31T03:29:09.056Z",
    "titleZh": "充氣膨脹海報",
    "promptZh": "創作一幅大膽的活動海報設計，全畫面呈現高飽和亮綠色充氣塑料包裝質感：背景為鼓脹起皺的亮綠色塑料材質，帶有輕微光澤與凸起隆起的表面紋理，如同充氣塑料包裝。將所有文字與圖形元素以相同的膨脹充氣3D效果呈現：粗厚圓潤、鼓脹的字型造型，彷彿充滿空氣，並帶有沿著圓潤表面分布的柔和高光與陰影。仔細觀察上傳照片中的主要主體究竟是什麼，然後根據該主體發想貼切的標題與簡短標語，例如若是飲品，則依其真實外觀、顏色與可能的風味命名；若是其他類型的物品，則依其外觀命名，不使用通用或無關的名稱。將標題文字以大膽膨脹的白色呈現，邊緣與綠色背景略微融合，搭配第二行膨脹黑色文字作為副標題，兩者皆須符合上傳照片的實際主體。在構圖中央放置上傳照片中的產品或主體，以與背景相同的充氣、膨脹、光澤亮綠材質呈現，彷彿由相同的充氣塑料製成，並以些微傾斜的角度置入背景之中，如同嵌入其中。在主體旁加入一行簡短的膨脹白色標語或口號，採用相同的充氣3D字體風格，內容須特別貼合照片中呈現的主體。在底部加入一行較小的膨脹白色輔助文字，貼合主體主題，不使用真實商家名稱、地點或地址。保持整體風格大膽、俏皮、復古街頭感，並帶有些許怪趣，每個元素皆呈現相同的充氣、膨脹、充滿空氣的質感。將色盤限制於高飽和亮綠色、白色與黑色，並保持全畫面材質風格高度一致。"
  },
  {
    "id": "b3e3b69d-b152-405b-ad06-a42fcb189e47",
    "title": "Acrylic Showcase Card",
    "prompt": "Create a modern, minimalist 3D product-display card design, with a warm gradient background transitioning naturally from light orange to deep wine-red. At the center of the composition, place a rounded-rectangle card with a transparent acrylic texture, semi-transparent, with soft ambient reflections on its surface, showing the product or subject from the uploaded photo displayed on or through the card. Look closely at what the subject in the uploaded photo actually is, then generate a fitting brand-style title in a large white sans-serif font at the top of the card, based specifically on that subject, not a generic or unrelated name, and never a real trademarked brand. Below it, add two or three short lines of smaller white feature-highlight text that fit the subject's actual visible qualities, for example, if it's a beauty or care product, highlight fitting qualities like its finish, gentleness, or effect; if it's a different kind of item, describe fitting qualities based on what it visibly is. Add one more line of smaller white supporting text near the bottom, also tailored to the subject, not a real business name or claim. Decorate the scene with copper-gold metallic rings framing the left and right sides of the acrylic card, with scattered spheres of varying sizes around it: one large textured orange-yellow sphere, one large deep-wine-red sphere, and several smaller copper and deep-wine-red spheres. Render the whole scene in 3D with soft, natural lighting, a unified warm color tone, and a minimalist, premium, strongly modern style, with clean, detailed material rendering, the acrylic's translucency and the metal's sheen clearly visible.",
    "identityMode": "none",
    "categoryId": "f871e8e7-6bc6-42f6-b020-80d083a50e01",
    "imageFile": "146f2b50-0efd-4f5f-9436-fc098878c798.jpg",
    "enabled": true,
    "order": -9,
    "createdAt": "2026-07-31T02:22:29.404Z",
    "updatedAt": "2026-07-31T06:56:49.456Z",
    "titleZh": "壓克力展示卡",
    "promptZh": "創作一款現代極簡風的3D產品展示卡設計，暖色調漸層背景自然過渡，從淺橙色到深酒紅色。在構圖中心放置一張圓角矩形卡片，帶有透明壓克力質感，半透明並帶有柔和的環境反光，卡片上或透過卡片展示上傳照片中的產品或主體。仔細觀察上傳照片中的主體究竟是什麼，然後在卡片頂部以大型白色無襯線字體生成貼切的品牌風格標題，須針對該主體具體發想，不使用通用或無關的名稱，也絕不使用真實商標品牌。下方加入兩到三行較小的白色特色重點文字，貼合主體的實際可見特質，例如若為美容或保養產品，可強調其質地、溫和度或效果等特質；若為其他類型的物品，則依其可見特質描述。在底部再加入一行較小的白色輔助文字，同樣貼合主體，非真實商家名稱或宣稱。以銅金色金屬質感圓環裝飾場景，環繞於壓克力卡片左右兩側，周圍散布不同大小的球體：一個帶紋理的橙黃色大球、一個深酒紅色大球，以及數個較小的銅色與深酒紅色球體。以3D方式渲染整個場景，搭配柔和自然的光線、統一的暖色調，以及極簡高級、現代感強烈的風格，材質渲染乾淨細膩，壓克力的通透感與金屬的光澤清晰可見。"
  },
  {
    "id": "092b830c-79d8-43f2-9605-f4106ef6908f",
    "title": "Splash Explosion",
    "prompt": "Transform the product from the uploaded photo into a dynamic splash-explosion product shot. Freeze the product mid-action, surrounded by dramatic splashing liquid, water droplets, and condensation frozen sharply in motion around it, as if captured with a high-speed flash. Light it with dramatic rim lighting and glossy, high-contrast highlights that trace the product's edges and the liquid droplets. Set it against a clean, dark or richly colored gradient background that makes the splash and highlights pop. Add a few complementary elements relevant to the product if fitting, such as fruit slices or ingredients related to what the product visibly is, frozen in motion around it. Look closely at what the product in the uploaded photo actually is, then add a short, bold title and tagline in clean modern lettering that fits its actual character, not a generic or unrelated name, and never a real trademarked brand. Keep the overall look premium, theatrical, and high-energy, like a luxury beverage or cosmetic advertisement. Preserve the product's exact shape, proportions, and visible design throughout.",
    "identityMode": "none",
    "categoryId": "f871e8e7-6bc6-42f6-b020-80d083a50e01",
    "imageFile": "c6b2a66c-36fa-4816-af98-b44ecb2591eb.jpg",
    "enabled": true,
    "order": -10,
    "createdAt": "2026-07-31T02:37:20.780Z",
    "updatedAt": "2026-07-31T06:56:49.466Z",
    "titleZh": "飛濺爆發",
    "promptZh": "將上傳照片中的產品轉變為動感十足的飛濺爆發商品拍攝畫面。將產品定格於動態瞬間，周圍環繞戲劇化飛濺的液體、水珠與凝結的水氣，彷彿以高速閃光燈捕捉而成。以戲劇性的輪廓光與光澤高對比高光打光，勾勒出產品邊緣與液體飛濺的輪廓。將其置於乾淨的深色或濃郁色彩漸層背景前，襯托飛濺與高光效果。若合適，可加入與產品相關的幾個搭配元素，例如水果切片或與產品可見類型相關的食材，凝結於周圍的動態瞬間中。仔細觀察上傳照片中的產品究竟是什麼，然後以簡潔現代的字體加入貼合其實際特質的簡短標題與標語，不使用通用或無關的名稱，也絕不使用真實商標品牌。保持整體觀感高級、戲劇化且充滿活力，如同奢華飲品或美妝廣告。全程保留產品精確的形狀、比例與可見設計。"
  },
  {
    "id": "48a212d9-0b4f-46f6-9158-935c2b0716e9",
    "title": "Black Gloss Podium",
    "prompt": "Transform the product from the uploaded photo into a luxury advertisement hero shot. Place the product centered on a glossy black podium or pedestal, with a mirror-like reflective surface beneath it showing a clean reflection of the product. Light it with a single dramatic light source from one side, creating deep shadows, glossy highlights, and rich contrast across the product's surface. Set it against a plain dark background that fades softly into black, keeping full focus on the product itself. Look closely at what the product in the uploaded photo actually is, then add a short, elegant title and tagline in a refined, minimal font placed subtly in the frame, based specifically on that product, not a generic or unrelated name, and never a real trademarked brand. Keep the overall style premium, editorial, and high-end, like a luxury watch, perfume, or jewelry advertisement. Preserve the product's exact shape, proportions, and visible design throughout.",
    "identityMode": "none",
    "categoryId": "f871e8e7-6bc6-42f6-b020-80d083a50e01",
    "imageFile": "a6becf49-3b32-4a96-aa0f-5eae243f81d8.jpg",
    "enabled": true,
    "order": -11,
    "createdAt": "2026-07-31T02:37:20.795Z",
    "updatedAt": "2026-07-31T06:56:49.470Z",
    "titleZh": "黑色亮面展台",
    "promptZh": "將上傳照片中的產品轉變為奢華廣告主視覺拍攝畫面。將產品置中放置於光澤黑色展示台或基座上，下方帶有鏡面反光表面，映照出產品清晰的倒影。以單一戲劇性光源從一側打光，在產品表面形成深邃陰影、光澤高光與濃郁對比。將其置於柔和淡入黑色的純色深色背景前，讓焦點完全集中於產品本身。仔細觀察上傳照片中的產品究竟是什麼，然後以精緻極簡的字體低調地在畫面中加入貼合該產品的簡短優雅標題與標語，不使用通用或無關的名稱，也絕不使用真實商標品牌。保持整體風格高級、編輯感十足且頂級，如同奢華手錶、香水或珠寶廣告。全程保留產品精確的形狀、比例與可見設計。"
  },
  {
    "id": "5ff49844-cb0b-4e0e-a44c-32dbea6a6d90",
    "title": "Neon Night Reflection",
    "prompt": "Transform the product from the uploaded photo into a moody night-time advertisement shot. Place the product on a dark, wet reflective surface, with its reflection visible beneath it. Light the scene with vivid neon signage glow in magenta, cyan, and electric blue, reflecting off the wet surface and the product's edges. Add a blurred, atmospheric city-night background behind the product, with soft bokeh lights and a sense of urban depth, out of focus so the product stays the clear subject. Look closely at what the product in the uploaded photo actually is, then add a short, bold title and tagline in a modern tech-style font, based specifically on that product, not a generic or unrelated name, and never a real trademarked brand. Keep the overall mood cinematic, futuristic, and high-contrast. Preserve the product's exact shape, proportions, and visible design throughout.",
    "identityMode": "none",
    "categoryId": "f871e8e7-6bc6-42f6-b020-80d083a50e01",
    "imageFile": "2ea311e6-58e8-4063-9c78-1ca9f9550a08.jpg",
    "enabled": true,
    "order": -12,
    "createdAt": "2026-07-31T02:37:20.798Z",
    "updatedAt": "2026-07-31T06:56:49.474Z",
    "titleZh": "霓虹夜色倒影",
    "promptZh": "將上傳照片中的產品轉變為氛圍濃厚的夜間廣告拍攝畫面。將產品置於深色濕潤的反光表面上，下方可見其倒影。以洋紅、青色與電光藍的鮮明霓虹招牌光暈為場景打光，反射於濕潤表面與產品邊緣。在產品後方加入模糊、氛圍濃厚的城市夜景背景，帶有柔和散景光點與都市深度感，皆保持失焦狀態，讓產品維持清晰主體地位。仔細觀察上傳照片中的產品究竟是什麼，然後以現代科技感字體加入貼合該產品的簡短大膽標題與標語，不使用通用或無關的名稱，也絕不使用真實商標品牌。保持整體氛圍電影感、未來感且高對比。全程保留產品精確的形狀、比例與可見設計。"
  },
  {
    "id": "b2d1694a-cf8f-42b2-8aa1-32957b1ac7ff",
    "title": "Seasonal Flat Lay",
    "prompt": "Transform the product from the uploaded photo into an overhead seasonal flat-lay advertisement shot. Arrange the product at the center of the composition, viewed from directly above, surrounded by seasonal natural elements that fit its character, fresh flowers, leaves, or ingredients relevant to what the product visibly is, arranged loosely and naturally around it. Light the whole scene with soft, warm natural daylight, casting gentle, soft-edged shadows. Use a clean, light neutral surface as the base, like a wooden table, linen fabric, or pale stone. Look closely at what the product in the uploaded photo actually is, then add a short, warm title and tagline in a soft, natural-feeling font placed neatly in the empty space, based specifically on that product, not a generic or unrelated name, and never a real trademarked brand. Keep the overall style organic, wholesome, and lifestyle-brand-like. Preserve the product's exact shape, proportions, and visible design throughout.",
    "identityMode": "none",
    "categoryId": "f871e8e7-6bc6-42f6-b020-80d083a50e01",
    "imageFile": "617244e4-1bb4-4740-9286-9434958b96bd.jpg",
    "enabled": true,
    "order": -13,
    "createdAt": "2026-07-31T02:37:20.803Z",
    "updatedAt": "2026-07-31T06:56:49.477Z",
    "titleZh": "季節平拍",
    "promptZh": "將上傳照片中的產品轉變為俯拍的季節性平拍廣告畫面。將產品置於構圖中心，以正上方視角呈現，周圍環繞符合其特質的季節性自然元素——新鮮花朵、葉片，或與產品可見類型相關的食材——隨性自然地散布於周圍。以柔和溫暖的自然日光為整個場景打光，投下柔和邊緣的陰影。使用乾淨淺色的中性表面作為基底，如木質桌面、亞麻布料或淺色石材。仔細觀察上傳照片中的產品究竟是什麼，然後以柔和自然感的字體，在空白處工整加入貼合該產品的簡短溫暖標題與標語，不使用通用或無關的名稱，也絕不使用真實商標品牌。保持整體風格自然、健康且具生活品牌感。全程保留產品精確的形狀、比例與可見設計。"
  },
  {
    "id": "83fcb7ac-e3ef-4c1b-b2bb-f7d3b8708179",
    "title": "Billboard Campaign",
    "prompt": "Transform the product from the uploaded photo into a realistic outdoor billboard advertisement mockup. Design a clean, bold poster ad featuring the product prominently, with the product's exact shape and design preserved, set against a simple, striking background color or gradient that complements it. Look closely at what the product in the uploaded photo actually is, then add a short, punchy title and tagline in large, bold lettering that fits its actual character, not a generic or unrelated name, and never a real trademarked brand. Then place this poster design mounted on a large billboard structure within a realistic city street scene at dusk, with soft cinematic blue-gray evening light, blurred buildings, streetlights, and a sense of real urban depth and scale around the billboard. Keep the billboard as the clear focal point, in sharp focus, with the surrounding city softly blurred. Keep the overall mood cinematic and aspirational, like a real outdoor ad campaign. Preserve the product's exact shape, proportions, and visible design throughout.",
    "identityMode": "none",
    "categoryId": "f871e8e7-6bc6-42f6-b020-80d083a50e01",
    "imageFile": "ad0108b8-28b4-4552-9aa5-6f1f2667714e.jpg",
    "enabled": true,
    "order": -14,
    "createdAt": "2026-07-31T02:37:20.808Z",
    "updatedAt": "2026-07-31T06:56:49.483Z",
    "titleZh": "廣告看板宣傳",
    "promptZh": "將上傳照片中的產品轉變為寫實的戶外廣告看板模擬圖。設計一幅乾淨大膽的海報廣告，突顯產品本身，保留其精確的形狀與設計，並置於簡單醒目、與其相襯的背景色彩或漸層前。仔細觀察上傳照片中的產品究竟是什麼，然後以大型粗體字加入貼合其實際特質的簡短有力標題與標語，不使用通用或無關的名稱，也絕不使用真實商標品牌。接著將此海報設計安裝於黃昏時分寫實城市街景中的大型廣告看板結構上，搭配柔和電影感的藍灰色暮色光線、模糊的建築物、街燈，以及看板周圍真實的都市深度與比例感。保持看板為清晰的視覺焦點，銳利對焦，周圍城市則柔和模糊。保持整體氛圍電影感且富有嚮往感，如同真實的戶外廣告宣傳。全程保留產品精確的形狀、比例與可見設計。"
  },
  {
    "id": "a5d17dd1-96ef-4db9-ab7e-4f5832875060",
    "title": "Unboxing Reveal",
    "prompt": "Transform the scene from the uploaded photo into an unboxing-moment product shot. Show the product being lifted out of or revealed from an open branded box, surrounded by soft crinkled tissue paper in a complementary color, with a ribbon or bow nearby. Include a pair of hands gently holding or lifting the product or the box lid, framed so the product remains the clear focus. Light the scene with soft, warm, natural light, like a cozy indoor moment, with a softly blurred neutral background. Look closely at what the product in the uploaded photo actually is, then style the box's exterior with a simple, fitting design and a short brand-style title based specifically on that product, not a generic or unrelated name, and never a real trademarked brand. Keep the overall mood personal, exciting, and social-media-friendly, like a genuine unboxing video moment. Preserve the product's exact shape, proportions, and visible design throughout.",
    "identityMode": "none",
    "categoryId": "f871e8e7-6bc6-42f6-b020-80d083a50e01",
    "imageFile": "4f4f3ef5-e823-4c65-83b5-35288f567729.jpg",
    "enabled": true,
    "order": -15,
    "createdAt": "2026-07-31T02:37:20.812Z",
    "updatedAt": "2026-07-31T02:51:36.558Z"
  }
]
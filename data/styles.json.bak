  },
  {
    "id": "eefd8335-35b4-4d37-9192-7e7e7bfd0214",
    "title": "Cyberpunk Neon",
    "prompt": "Transform the scene into a moody cyberpunk night-city portrait, keeping the person's pose, facial features, hairstyle, and clothing silhouette recognizable. Light the person primarily with vivid neon rim lighting — magenta, cyan, and electric-blue accents wrapping the edges of their face, hair, and clothing — against a dark, high-contrast background. Add subtle futuristic wardrobe accents consistent with the original outfit (a glossy jacket sheen, a faint holographic patch, or reflective material highlights) without fully replacing their actual clothing. The background should suggest a rain-slicked futuristic city street or alley at night: blurred neon signage, glowing window reflections, soft atmospheric haze, and bokeh light spots, all kept out of sharp focus so the person stays the clear subject. Add fine film-grain texture and slightly elevated contrast for a cinematic night-photography feel. Preserve the person's recognizable identity and expression throughout. Do not generate: daytime lighting, cartoon/anime style, flat illustration coloring, loss of facial identity, or an overly busy background that competes with the subject.",
    "identityMode": "reinforced",
    "imageFile": "2220c60e-5009-4513-8ddf-130f76a6a3eb.jpg",
    "enabled": true,
    "order": 16,

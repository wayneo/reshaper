  },
  {
    "id": "c134b04f-15e3-4b0b-879f-30181245dcc1",
    "title": "Pen Sketch Notebook",
    "prompt": "Transform the person in the photo into a bold pen-sketch illustration, using this photo as the reference. Outline the figure with confident, flowing strokes in bold red and warm yellow ink, keeping visible sketch marks and cross-hatched shading throughout. Set the figure against notebook-style paper with soft ruled lines as the background, surrounded by doodle-style decorations: hearts, arrows, stars, and handwritten lettering. Keep the overall style modern and pop-art-influenced, with an editorial sketchbook aesthetic, fashionable and expressive, rich in detail, blending flat graphic elements with realistic hand-drawn touches. Fill the frame completely, no black or empty/blank areas should appear anywhere in the image. Preserve the person's recognizable pose, facial features, and identity throughout. Do not generate: photorealistic skin texture, a plain empty background, or loss of the person's recognizable identity.",
    "identityMode": "reinforced",
    "categoryId": "4ed760a1-09f7-4274-aa0d-83a30ca389db",
    "imageFile": "d21e3084-9df7-4f7f-8e66-d14f3c12ddbd.jpg",
    "enabled": true,

  },
  {
    "id": "83586d3c-cb31-4a54-be54-6fa5ae31b780",
    "title": "Vintage Magazine Collage",
    "prompt": "Using the person in the photo as the subject, create a vintage fashion-magazine torn-paper collage artwork. The portrait subject looks as if it were torn out of a 1990s fashion magazine, with rough, irregular paper edges and natural drop shadows where paper pieces overlap. Pair the background with scattered newspaper text fragments, colored paper strips, and staple marks. Use colored markers to add hand-drawn annotations, arrows, short handwritten notes, and simple line decorations in the empty areas. The overall tone should be slightly yellowed and aged, keeping a candid, relaxed feel — artsy, vintage, and full of hand-made DIY charm. Do not generate: a fully smooth seamless image, glossy digital texture, a neat clean composition, overly vibrant modern colors, perfectly cropped edges, 3D rendering, uniform lighting, a CG look, overly polished rendering, or seamless compositing.",
    "identityMode": "reinforced",
    "imageFile": "2a0eca7f-1115-458b-bd01-4886e03ef3e8.jpg",
    "enabled": true,
    "order": 20,
    "createdAt": "2026-07-22T02:11:46.237Z",
    "updatedAt": "2026-07-24T11:21:43.039Z",
    "categoryId": "6ad0a676-4347-4eb6-9db1-7b3938f373ae"
  },
  {
    "id": "67b8ae3a-6d78-433d-9b4a-47251af82771",
    "title": "Anime Figure in Box",
    "prompt": "Transform the person into a highly detailed collectible anime/nendoroid-style figure, displayed inside clear plastic blister packaging like a boxed action figure. Keep the person's pose, facial expression, hairstyle, clothing silhouette, and overall identity recognizable, rendered in a glossy PVC-figure material with smooth painted surfaces, soft cel-shaded highlights, and visible plastic sheen. Give the figure cute, slightly stylized proportions typical of collectible figures — slightly larger eyes, smooth simplified facial detail — while keeping the person clearly recognizable. Place the figure standing on a small circular plastic base with a printed logo-style label. Surround it with realistic blister-pack packaging: a clear plastic dome or window, printed cardboard backing with soft gradient background art, small printed text blocks and barcode-style graphic elements (illegible/generic, not real text), and one or two accessory pieces (like a small prop or interchangeable hand) tucked in a plastic tray beside the figure. Lighting should look like a product photo — soft studio lighting, subtle shadow beneath the packaging, slight reflective highlight on the plastic. Do not generate: realistic human skin texture on the figure, a fully photographic person, blurry or low-detail packaging, a different pose or outfit than the original, loss of facial identity, or a cluttered background outside the packaging.",
    "identityMode": "reinforced",
    "imageFile": "7569ff6f-8b96-40f5-8e46-8fc96f46e708.jpg",
    "enabled": true,
    "order": 19,
    "createdAt": "2026-07-24T02:02:33.799Z",
    "updatedAt": "2026-07-24T11:21:43.039Z",
    "categoryId": "38d3befa-39e5-47d4-bf0b-a140792b2ac3"
  },
  {
    "id": "4a621fed-1eab-452d-a44e-c77a7910a86f",
    "title": "LEGO Minifigure",
    "prompt": "Rebuild the person as a LEGO minifigure, keeping their pose, hairstyle silhouette, clothing colors/design, and overall identity recognizable within LEGO's iconic block style. Use a cylindrical head (yellow, or skin-toned if closer to the original) with minimal simplified facial features printed in the flat LEGO graphic style, a blocky trapezoidal torso printed with the person's clothing design, simplified block arms and hands with the classic claw-shaped LEGO hand, and short block legs matching the original pants/clothing color. Hair or hats should be modeled as a separate glossy LEGO hairpiece/hat accessory shaped to match the original hairstyle. Keep the plastic look glossy and smooth, with the characteristic LEGO stud visible on top of the head if hatless. Place the figure standing on a LEGO baseplate, either alone or with a couple of small simple LEGO-brick props relevant to the original photo's setting. The background can be a plain, softly lit studio backdrop or a simplified brick-built scene echoing the original environment. Do not generate: realistic human skin or hair texture, a fully photographic figure, loss of the original pose or outfit colors, unrecognizable identity, or a cluttered/realistic background.",
    "identityMode": "reinforced",
    "imageFile": "c5477126-b0d7-4591-a673-417688e2ee28.jpg",
    "enabled": true,
    "order": 18,
    "createdAt": "2026-07-24T02:02:33.810Z",
    "updatedAt": "2026-07-24T11:21:43.039Z",
    "categoryId": "38d3befa-39e5-47d4-bf0b-a140792b2ac3"
  },
  {
    "id": "99ef2b26-20c1-4613-b797-279f4a0801c5",
    "title": "Watercolor Portrait",
    "prompt": "Convert the photo into a soft, hand-painted watercolor portrait, preserving the person's pose, facial features, hairstyle, and clothing silhouette so they remain clearly recognizable. Use loose, flowing watercolor brushwork with visible pigment blooms, soft color bleeding at edges, and gentle gradients rather than hard outlines. Keep a light, airy color palette with occasional deeper pigment pooling for shadow areas, and leave visible white paper texture showing through in highlight areas. Facial features should be softly rendered — simplified but still expressive and identifiable — built mostly from color washes with minimal hard linework. The background should be minimal: a soft wash of complementary color, a light paper-texture vignette, or a loosely suggested environment echoing the original setting, without hard edges or fine detail. Overall mood: gentle, artistic, and light-filled, like a traditional watercolor portrait painted from life. Do not generate: photorealistic texture, hard vector outlines, flat cartoon coloring, 3D rendering, digital airbrush smoothness, or loss of the person's recognizable identity.",
    "identityMode": "reinforced",
    "imageFile": "c2df4334-6201-4bb7-935f-e3cbba1988b8.jpg",
    "enabled": true,
    "order": 17,

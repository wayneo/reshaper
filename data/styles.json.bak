  },
  {
    "id": "22f79227-46ca-4c87-afb4-6bb6a679bc3b",
    "title": "Fridge Magnet Icon",
    "prompt": "Extract the most recognizable main subject from the photo and turn it into a simplified fridge-magnet-style icon. Keep the subject's core silhouette and signature features, with an overall clean, minimal design, giving it the look of a travel-souvenir fridge magnet. Give it a slight three-dimensional, raised feel with a soft drop shadow beneath it, clear-edged outlines paired with a light or white border stroke around the whole shape. Simplify details moderately without overworking them, keep the icon small, neat, and refined, and leave generous white space around it on a plain background. Preserve the recognizable identity, pose, and key features of the original subject throughout. Do not generate: a fully flat 2D sticker with no depth, a cluttered or busy background, or loss of the subject's recognizable identity.",
    "identityMode": "reinforced",
    "categoryId": "38d3befa-39e5-47d4-bf0b-a140792b2ac3",
    "imageFile": null,
    "enabled": true,
    "order": 3,
